{
  "name": "@i18n-micro/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt Content documentation site for nuxt-i18n-micro.",
  "scripts": {
    "generate": "pnpm -C ../scripts cli docs-generate",
    "dev": "pnpm run generate && nuxt dev",
    "build": "pnpm run generate && nuxt generate",
    "preview": "node preview.mjs",
    "clean-dev": "pnpm run generate && nuxt dev --clear",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxt/content": "catalog:",
    "@nuxt/image": "catalog:",
    "@nuxt/ui": "catalog:",
    "@takumi-rs/core": "catalog:",
    "better-sqlite3": "catalog:",
    "chart.js": "catalog:",
    "nuxt": "catalog:",
    "nuxt-llms": "catalog:",
    "nuxt-og-image": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "ufo": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}
