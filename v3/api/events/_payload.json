18nLocale","v3\u002Fcomposables\u002FuseI18nLocale",{"title":735,"path":736,"stem":737,"order":39},"Examples","\u002Fv3\u002Fexamples","v3\u002Fexamples",{"id":739,"title":613,"body":740,"description":1780,"extension":1781,"lastUpdated":1782,"links":1782,"meta":1783,"navigation":1784,"path":614,"seo":1785,"stem":615,"__hash__":1786},"v3\u002Fv3\u002Fapi\u002Fevents.md",{"type":741,"value":742,"toc":1764},"minimark",[743,752,763,768,863,867,880,906,913,936,940,946,1121,1125,1132,1172,1176,1198,1204,1207,1211,1214,1220,1223,1269,1275,1281,1284,1662,1666,1673,1694,1701,1721,1725,1757,1760],[744,745,747,748],"h2",{"id":746},"i18nregister","🔄 ",[749,750,751],"code",{},"i18n:register",[753,754,755,756,758,759,762],"p",{},"The ",[749,757,751],{}," event in ",[749,760,761],{},"Nuxt I18n Micro"," enables dynamic addition of translations to your application's i18n context, making the internationalization process seamless and flexible. This event allows you to integrate new translations as needed, enhancing your application's localization capabilities.",[764,765,767],"h3",{"id":766},"event-details","📝 Event Details",[769,770,771,784,850],"ul",{},[772,773,774,778,779],"li",{},[775,776,777],"strong",{},"Purpose",":",[769,780,781],{},[772,782,783],{},"Allows dynamic incorporation of additional translations into the existing set for a specific locale.",[772,785,786,778,789],{},[775,787,788],{},"Payload",[769,790,791],{},[772,792,793,798,799],{},[775,794,795],{},[749,796,797],{},"register",":\n",[769,800,801],{},[772,802,803,804],{},"A function provided by the event that takes two arguments:\n",[769,805,806,826],{},[772,807,808,813,814,817,818],{},[775,809,810],{},[749,811,812],{},"translations"," (",[749,815,816],{},"Translations","):\n",[769,819,820],{},[772,821,822,823,825],{},"An object containing key-value pairs representing translations, organized according to the ",[749,824,816],{}," interface.",[772,827,828,813,833,836,837],{},[775,829,830],{},[749,831,832],{},"locale",[749,834,835],{},"string",", optional):\n",[769,838,839],{},[772,840,841,842,845,846,849],{},"The locale code (e.g., ",[749,843,844],{},"'en'",", ",[749,847,848],{},"'ru'",") for which the translations are registered. Defaults to the locale provided by the event if not specified.",[772,851,852,778,855],{},[775,853,854],{},"Behavior",[769,856,857],{},[772,858,859,860,862],{},"When triggered, the ",[749,861,797],{}," function merges the new translations into the current context for the specified locale, updating the available translations across the application.",[764,864,866],{"id":865},"️-when-it-fires","⏱️ When It Fires",[753,868,869,870,845,873,876,877,778],{},"The module's hooks plugin (",[749,871,872],{},"05.hooks.ts",[749,874,875],{},"dependsOn: ['i18n-plugin-loader']",") calls ",[749,878,879],{},"nuxtApp.callHook('i18n:register', …)",[881,882,883,893],"ol",{},[772,884,885,888,889,892],{},[775,886,887],{},"Once on startup"," — after the main i18n plugin (",[749,890,891],{},"01.plugin.ts",") has loaded translations for the initial route",[772,894,895,898,899,902,903],{},[775,896,897],{},"On navigation"," — in ",[749,900,901],{},"router.beforeEach"," when the path changes, or on every navigation when ",[749,904,905],{},"strategy: 'no_prefix'",[753,907,908,909,912],{},"Register your listener in a normal Nuxt plugin with ",[749,910,911],{},"nuxtApp.hook('i18n:register', …)",". The hooks plugin runs after the loader is ready, so your callback is invoked when translations need to be extended.",[753,914,915,916,919,920,923,924,926,927,935],{},"Set ",[749,917,918],{},"hooks: false"," in ",[749,921,922],{},"nuxt.config"," to disable automatic ",[749,925,751],{}," calls (see ",[928,929,931,932],"a",{"href":930},"\u002Fv3\u002Fguide\u002Fconfiguration#hooks","Configuration — ",[749,933,934],{},"hooks",").",[764,937,939],{"id":938},"example-usage","💡 Example Usage",[753,941,942,943,945],{},"The following example demonstrates how to use the ",[749,944,751],{}," event to dynamically add translations:",[947,948,953],"pre",{"className":949,"code":950,"language":951,"meta":952,"style":952},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","nuxt.hook('i18n:register', async (register: (translations: unknown, locale?: string) => void, locale: string) => {\n  register(\n    {\n      greeting: 'Hello',\n      farewell: 'Goodbye',\n    },\n    locale,\n  )\n})\n","typescript","",[749,954,955,1041,1051,1057,1076,1093,1099,1107,1113],{"__ignoreMap":952},[956,957,959,963,967,971,974,977,980,982,985,989,991,993,995,997,1000,1002,1006,1008,1011,1014,1017,1020,1023,1026,1028,1030,1032,1034,1036,1038],"span",{"class":958,"line":353},"line",[956,960,962],{"class":961},"sTEyZ","nuxt",[956,964,966],{"class":965},"sMK4o",".",[956,968,970],{"class":969},"s2Zo4","hook",[956,972,973],{"class":961},"(",[956,975,976],{"class":965},"'",[956,978,751],{"class":979},"sfazB",[956,981,976],{"class":965},[956,983,984],{"class":965},",",[956,986,988],{"class":987},"spNyl"," async",[956,990,813],{"class":965},[956,992,797],{"class":969},[956,994,778],{"class":965},[956,996,813],{"class":965},[956,998,812],{"class":999},"sHdIc",[956,1001,778],{"class":965},[956,1003,1005],{"class":1004},"sBMFI"," unknown",[956,1007,984],{"class":965},[956,1009,1010],{"class":999}," locale",[956,1012,1013],{"class":965},"?:",[956,1015,1016],{"class":1004}," string",[956,1018,1019],{"class":965},")",[956,1021,1022],{"class":987}," =>",[956,1024,1025],{"class":1004}," void",[956,1027,984],{"class":965},[956,1029,1010],{"class":999},[956,1031,778],{"class":965},[956,1033,1016],{"class":1004},[956,1035,1019],{"class":965},[956,1037,1022],{"class":987},[956,1039,1040],{"class":965}," {\n",[956,1042,1044,1047],{"class":958,"line":1043},2,[956,1045,1046],{"class":969},"  register",[956,1048,1050],{"class":1049},"swJcz","(\n",[956,1052,1054],{"class":958,"line":1053},3,[956,1055,1056],{"class":965},"    {\n",[956,1058,1060,1063,1065,1068,1071,1073],{"class":958,"line":1059},4,[956,1061,1062],{"class":1049},"      greeting",[956,1064,778],{"class":965},[956,1066,1067],{"class":965}," '",[956,1069,1070],{"class":979},"Hello",[956,1072,976],{"class":965},[956,1074,1075],{"class":965},",\n",[956,1077,1079,1082,1084,1086,1089,1091],{"class":958,"line":1078},5,[956,1080,1081],{"class":1049},"      farewell",[956,1083,778],{"class":965},[956,1085,1067],{"class":965},[956,1087,1088],{"class":979},"Goodbye",[956,1090,976],{"class":965},[956,1092,1075],{"class":965},[956,1094,1096],{"class":958,"line":1095},6,[956,1097,1098],{"class":965},"    },\n",[956,1100,1102,1105],{"class":958,"line":1101},7,[956,1103,1104],{"class":961},"    locale",[956,1106,1075],{"class":965},[956,1108,1110],{"class":958,"line":1109},8,[956,1111,1112],{"class":1049},"  )\n",[956,1114,1115,1118],{"class":958,"line":358},[956,1116,1117],{"class":965},"}",[956,1119,1120],{"class":961},")\n",[764,1122,1124],{"id":1123},"️-explanation","🛠️ Explanation",[1126,1127],"docs-diagram",{"alt":1128,"height":1129,"name":1130,"width":1131},"Diagram: 🛠️ Explanation",586,"api-events-1",1271,[769,1133,1134,1150],{},[772,1135,1136,778,1139],{},[775,1137,1138],{},"Triggering the Event",[769,1140,1141],{},[772,1142,1143,1144,1146,1147,1149],{},"The hooks plugin (",[749,1145,872],{},") fires ",[749,1148,751],{}," after the main loader is ready and on relevant navigations.",[772,1151,1152,778,1155],{},[775,1153,1154],{},"Adding Translations",[769,1156,1157,1167],{},[772,1158,1159,1160,1163,1164,966],{},"The example registers English translations for ",[749,1161,1162],{},"\"greeting\""," and ",[749,1165,1166],{},"\"farewell\"",[772,1168,755,1169,1171],{},[749,1170,797],{}," function merges these translations into the existing set for the provided locale.",[764,1173,1175],{"id":1174},"key-benefits","🔗 Key Benefits",[769,1177,1178,1188],{},[772,1179,1180,778,1183],{},[775,1181,1182],{},"Dynamic Updates",[769,1184,1185],{},[772,1186,1187],{},"Easily update or add translations without needing to redeploy your entire application.",[772,1189,1190,778,1193],{},[775,1191,1192],{},"Localization Flexibility",[769,1194,1195],{},[772,1196,1197],{},"Supports real-time localization adjustments based on user or application needs.",[753,1199,1200,1201,1203],{},"Using the ",[749,1202,751],{}," event, you can ensure that your application's localization strategy remains flexible and adaptable, enhancing the overall user experience.",[1205,1206],"hr",{},[744,1208,1210],{"id":1209},"️-modifying-translations-with-plugins","🛠️ Modifying Translations with Plugins",[753,1212,1213],{},"To modify translations dynamically in your Nuxt application, using plugins is recommended. Plugins provide a structured way to handle localization updates, especially when working with modules or external translation files.",[764,1215,1217],{"id":1216},"registering-the-plugin",[775,1218,1219],{},"Registering the Plugin",[753,1221,1222],{},"If you're using a module, register the plugin where translation modifications will occur by adding it to your module’s configuration:",[947,1224,1228],{"className":1225,"code":1226,"language":1227,"meta":952,"style":952},"language-javascript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","addPlugin({\n  src: resolve('.\u002Fplugins\u002Fextend_locales'),\n})\n","javascript",[749,1229,1230,1240,1263],{"__ignoreMap":952},[956,1231,1232,1235,1237],{"class":958,"line":353},[956,1233,1234],{"class":969},"addPlugin",[956,1236,973],{"class":961},[956,1238,1239],{"class":965},"{\n",[956,1241,1242,1245,1247,1250,1252,1254,1257,1259,1261],{"class":958,"line":1043},[956,1243,1244],{"class":1049},"  src",[956,1246,778],{"class":965},[956,1248,1249],{"class":969}," resolve",[956,1251,973],{"class":961},[956,1253,976],{"class":965},[956,1255,1256],{"class":979},".\u002Fplugins\u002Fextend_locales",[956,1258,976],{"class":965},[956,1260,1019],{"class":961},[956,1262,1075],{"class":965},[956,1264,1265,1267],{"class":958,"line":1053},[956,1266,1117],{"class":965},[956,1268,1120],{"class":961},[753,1270,1271,1272,1274],{},"This registers the plugin located at ",[749,1273,1256],{},", which will handle dynamic loading and registration of translations.",[764,1276,1278],{"id":1277},"implementing-the-plugin",[775,1279,1280],{},"Implementing the Plugin",[753,1282,1283],{},"In the plugin, you can manage locale modifications. Here's an example implementation in a Nuxt plugin:",[947,1285,1287],{"className":949,"code":1286,"language":951,"meta":952,"style":952},"import { defineNuxtPlugin } from '#app'\n\nexport default defineNuxtPlugin(async (nuxtApp) => {\n  \u002F\u002F Function to load translations from JSON files and register them\n  const loadTranslations = async (lang: string) => {\n    try {\n      const translations = await import(`..\u002Flocales\u002F${lang}.json`)\n      return translations.default\n    } catch (error) {\n      console.error(`Error loading translations for language: ${lang}`, error)\n      return null\n    }\n  }\n\n  \u002F\u002F Hook into the 'i18n:register' event to dynamically add translations\n  \u002F\u002F eslint-disable-next-line @typescript-eslint\u002Fban-ts-comment\n  \u002F\u002F @ts-expect-error\n  nuxtApp.hook('i18n:register', async (register: (translations: unknown, locale?: string) => void, locale: string) => {\n    const translations = await loadTranslations(locale)\n    if (translations) {\n      register(translations, locale)\n    }\n  })\n})\n",[749,1288,1289,1315,1321,1347,1353,1381,1388,1426,1438,1456,1486,1494,1500,1506,1511,1517,1523,1529,1593,1613,1626,1642,1647,1655],{"__ignoreMap":952},[956,1290,1291,1295,1298,1301,1304,1307,1309,1312],{"class":958,"line":353},[956,1292,1294],{"class":1293},"s7zQu","import",[956,1296,1297],{"class":965}," {",[956,1299,1300],{"class":961}," defineNuxtPlugin",[956,1302,1303],{"class":965}," }",[956,1305,1306],{"class":1293}," from",[956,1308,1067],{"class":965},[956,1310,1311],{"class":979},"#app",[95