l,{},{"title":501,"order":102,"group":482},{"title":501,"description":1678},"-vq2pLXK_A0Fli3rairv3fdL0i1T7Y2wg2ZCZvjcmM0",[1686,1689],{"title":1687,"path":498,"description":1688},"Firebase AppHosting Deployment","Deploy nuxt-i18n-micro on Firebase AppHosting.",{"title":505,"path":506,"description":1690},"Local production-preset checks for Vercel \u002F Cloudflare \u002F Netlify — Nitro-style runners + smoke-verify.",1794050489520]