99],{"class":770,"line":798},4,[768,800,801],{"class":773},"# Fast unit tests only — no builds, no browser (~1s)\n",[768,803,805,807,809],{"class":770,"line":804},5,[768,806,781],{"class":780},[768,808,785],{"class":784},[768,810,811],{"class":784}," test:unit\n",[768,813,815],{"class":770,"line":814},6,[768,816,795],{"emptyLinePlaceholder":794},[768,818,820],{"class":770,"line":819},7,[768,821,822],{"class":773},"# Build-heavy integration suites (strategies, generate, production servers)\n",[768,824,826,828,830],{"class":770,"line":825},8,[768,827,781],{"class":780},[768,829,785],{"class":784},[768,831,832],{"class":784}," test:integration\n",[768,834,835],{"class":770,"line":358},[768,836,795],{"emptyLinePlaceholder":794},[768,838,839],{"class":770,"line":6},[768,840,841],{"class":773},"# Browser e2e project (shared prebuilt fixtures + isolated specs), via Vitest\n",[768,843,845,847,849],{"class":770,"line":844},11,[768,846,781],{"class":780},[768,848,785],{"class":784},[768,850,851],{"class":784}," test:e2e\n",[768,853,855],{"class":770,"line":854},12,[768,856,795],{"emptyLinePlaceholder":794},[768,858,860],{"class":770,"line":859},13,[768,861,862],{"class":773},"# Everything (unit + integration + e2e + packages)\n",[768,864,866,868,870],{"class":770,"line":865},14,[768,867,781],{"class":780},[768,869,785],{"class":784},[768,871,872],{"class":784}," test\n",[754,874,876],{"id":875},"project-layout","Project layout",[878,879,880,896],"table",{},[881,882,883],"thead",{},[884,885,886,890,893],"tr",{},[887,888,889],"th",{},"Project",[887,891,892],{},"Contents",[887,894,895],{},"Config",[897,898,899,915,945,964],"tbody",{},[884,900,901,907,910],{},[902,903,904],"td",{},[749,905,906],{},"unit",[902,908,909],{},"pure unit tests, no Nuxt build",[902,911,912],{},[749,913,914],{},"vitest.unit.config.ts",[884,916,917,922,940],{},[902,918,919],{},[749,920,921],{},"integration",[902,923,924,925,928,929,932,933,936,937],{},"suites that spawn ",[749,926,927],{},"nuxi build","\u002F",[749,930,931],{},"generate"," or ",[749,934,935],{},"@nuxt\u002Ftest-utils"," ",[749,938,939],{},"setup()",[902,941,942],{},[749,943,944],{},"vitest.integration.config.ts",[884,946,947,952,959],{},[902,948,949],{},[749,950,951],{},"e2e",[902,953,954,955,958],{},"browser specs (",[749,956,957],{},"*.spec.ts",") against real servers",[902,960,961],{},[749,962,963],{},"vitest.e2e.config.ts",[884,965,966,969,975],{},[902,967,968],{},"package projects",[902,970,971,972],{},"one per ",[749,973,974],{},"packages\u002F*",[902,976,977],{},[749,978,979],{},"packages\u002F*\u002Fvitest.config.ts",[745,981,982,983,985,986,988,989,992,993,996],{},"The ",[749,984,906],{}," \u002F ",[749,987,921],{}," split has a single source of truth: ",[749,990,991],{},"INTEGRATION_TESTS"," in ",[749,994,995],{},"test\u002Fsetup\u002Fheavy-tests.ts"," — the integration config includes that list and the unit config excludes it, so the two can never drift.",[754,998,1000],{"id":999},"what-the-strategy-suites-cover","What the strategy suites cover",[745,1002,1003,1004,1007,1008,1007,1011,1007,1014,1017,1018,1021,1022,1025],{},"For each strategy (",[749,1005,1006],{},"no_prefix",", ",[749,1009,1010],{},"prefix_except_default",[749,1012,1013],{},"prefix",[749,1015,1016],{},"prefix_and_default",") there is one file — ",[749,1019,1020],{},"test\u002Fstrategies-\u003Cstrategy>.test.ts"," — so Vitest, which parallelizes per file, can run all four concurrently. They share one implementation in ",[749,1023,1024],{},"test\u002Fhelpers\u002Fstrategy-suite.ts",":",[1027,1028,1029,1049],"ol",{},[1030,1031,1032,1036,1037,1040,1041,1044,1045,1048],"li",{},[1033,1034,1035],"strong",{},"Static generate"," — runs ",[749,1038,1039],{},"nuxi generate"," into an isolated build dir (",[749,1042,1043],{},"NUXT_TEST_BUILD_DIR","), serves ",[749,1046,1047],{},"public\u002F",", checks locale routes.",[1030,1050,1051,1036,1054,1056],{},[1033,1052,1053],{},"SSR build",[749,1055,927],{},", starts the Nitro server, checks the same routes over HTTP.",[745,1058,1059,1060,1063,1064,1067,1068,752],{},"Generate-only regressions (prerender success, payload files, nested routes) live in ",[749,1061,1062],{},"test\u002Fstrategies-generate.test.ts"," via ",[749,1065,1066],{},"registerStrategyGenerateTests()"," (",[749,1069,1070],{},"test\u002Fhelpers\u002Fstrategy-generate.ts",[754,1072,1074],{"id":1073},"parallelism","Parallelism",[745,1076,1077],{},"Two rules keep build-spawning suites safe to run concurrently:",[1079,1080,1081,1098],"ul",{},[1030,1082,1083,1086,1087,1090,1091,1093,1094,1097],{},[1033,1084,1085],{},"Own build dir per suite and phase"," — ",[749,1088,1089],{},"isolatedBuild(fixture, name)"," points ",[749,1092,1043],{}," at ",[749,1095,1096],{},"test\u002Ffixtures\u002F\u003Cfixture>\u002F.nuxt-test\u002F\u003Cname>\u002F",", so nothing rimrafs or reads another suite's output.",[1030,1099,1100,1103,1104,1067,1107,1110,1111,1067,1114,1117,1118,1121,1122,1125,1126,1129],{},[1033,1101,1102],{},"OS-assigned ports, handle-based shutdown"," — take ports from ",[749,1105,1106],{},"getFreePort()",[749,1108,1109],{},"test\u002Fhelpers\u002Fport.ts",", binds port 0) and stop servers with ",[749,1112,1113],{},"stopChild()",[749,1115,1116],{},"test\u002Fhelpers\u002Fsubprocess.ts","), which kills the whole process group. Never free a port by killing whatever process owns it (",[749,1119,1120],{},"lsof -ti tcp:\u003Cport>"," + ",[749,1123,1124],{},"SIGKILL","): with parallel workers that can kill a sibling suite's server, which surfaces as an unrelated ",[749,1127,1128],{},"ERR_IPC_CHANNEL_CLOSED"," crash.",[754,1131,1133],{"id":1132},"e2e-shared-fixtures","E2E shared fixtures",[745,1135,1136,1137,1140,1141,1144,1145,1148,1149,1152,1153,1156,1157,1160,1161,1164,1165,1168],{},"Browser e2e specs run through Vitest (",[749,1138,1139],{},"--project e2e",") driving a real Playwright browser against real Nuxt servers — see ",[749,1142,1143],{},"test\u002Fsetup\u002Fvitest-e2e.ts",". Specs without per-spec ",[749,1146,1147],{},"nuxtConfig"," connect to prebuilt servers started once by ",[749,1150,1151],{},"test\u002Fsetup\u002Fvitest-global-setup.ts"," (build\u002Fserve logic in ",[749,1154,1155],{},"shared-fixtures-core.ts",") via ",[749,1158,1159],{},"setupE2E({ shared: '\u003Cfixture>' })",". Specs with custom config or ",[749,1162,1163],{},"dev: true"," build their own app per file via ",[749,1166,1167],{},"setupE2E({ rootDir, nuxtConfig })",".",[745,1170,1171,1172,1168],{},"See also ",[1173,1174,331],"a",{"href":521},[1176,1177,1178],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--s