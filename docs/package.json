{
  "name": "@i18n-micro/docs",
  "version": "0.0.0",
  "private": true,
  "description": "VitePress documentation site for nuxt-i18n-micro.",
  "type": "module",
  "scripts": {
    "generate": "pnpm -C ../scripts cli docs-generate",
    "dev": "pnpm run generate && vitepress dev .",
    "build": "pnpm run generate && vitepress build .",
    "clean-dev": "pnpm run generate && vitepress dev . --clean-cache",
    "preview": "vitepress preview ."
  },
  "devDependencies": {
    "axios": "catalog:",
    "chart.js": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-chartjs": "catalog:",
    "vitepress-plugin-folder-tree": "catalog:",
    "vitepress-plugin-llms": "catalog:"
  }
}
