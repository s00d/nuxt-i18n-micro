v3\u002Fcomposables\u002FuseI18nLocale",{"title":735,"path":736,"stem":737,"order":39},"Examples","\u002Fv3\u002Fexamples","v3\u002Fexamples",{"id":739,"title":368,"body":740,"description":1336,"extension":1337,"lastUpdated":1338,"links":1339,"meta":1340,"navigation":1341,"path":369,"seo":1342,"stem":370,"__hash__":1343},"docs\u002Fnews\u002Fv3.22.0.md",{"type":741,"value":742,"toc":1312},"minimark",[743,747,752,760,769,776,786,790,803,806,845,864,871,889,901,910,921,953,964,968,985,994,997,1053,1060,1073,1077,1080,1169,1173,1238,1242,1253,1262,1265,1276,1281],[744,745,368],"h1",{"id":746},"v3220",[748,749,751],"h2",{"id":750},"nuxt-i18n-micro-v3220-formats-cache-translation-memory","Nuxt I18n Micro v3.22.0 — Formats, Cache & Translation Memory",[753,754,755,759],"p",{},[756,757,758],"strong",{},"Date",": 2026-07-30",[753,761,762,765,766],{},[756,763,764],{},"Version",": ",[767,768,368],"code",{},[753,770,771],{},[772,773],"img",{"alt":774,"src":775},"v3.22.0 release","\u002F3.22.0.png",[753,777,778,779,781,782,785],{},"We're announcing ",[756,780,368],{},": Vue I18n-style named number\u002Fdate formats with a formatter cache, CDN-friendly translation payload caching (content fingerprint + ",[767,783,784],{},"httpCacheDuration","), and a Translation Memory API to read and replace the active dictionary at runtime.",[748,787,789],{"id":788},"whats-new","What's New?",[791,792,794,795,798,799,802],"h3",{"id":793},"named-numberformats-datetimeformats-formatter-cache","Named ",[767,796,797],{},"numberFormats"," \u002F ",[767,800,801],{},"datetimeFormats"," + formatter cache",[753,804,805],{},"Vue I18n-compatible named formats and faster Intl formatting:",[807,808,809,818,829],"ul",{},[810,811,812,813,798,815,817],"li",{},"Config: ",[767,814,797],{},[767,816,801],{}," per locale",[810,819,820,821,824,825,828],{},"API: ",[767,822,823],{},"$tn(1000, 'currency')",", ",[767,826,827],{},"$td(date, 'short')"," (+ locale override and option merges)",[810,830,831,834,835,798,838,798,841,844],{},[767,832,833],{},"FormatService"," caches ",[767,836,837],{},"Intl.NumberFormat",[767,839,840],{},"DateTimeFormat",[767,842,843],{},"RelativeTimeFormat"," by locale+options",[753,846,847,848,859,860,863],{},"See ",[849,850,852,853,798,856],"a",{"href":851},"\u002Fapi\u002Fmethods#tn","Methods — ",[767,854,855],{},"$tn",[767,857,858],{},"$td"," and ",[849,861,189],{"href":862},"\u002Fapi\u002Fmodule-options#numberformats",".",[791,865,867,870],{"id":866},"datebuild-defaults-to-a-content-fingerprint",[767,868,869],{},"dateBuild"," defaults to a content fingerprint",[753,872,873,876,877,880,881,884,885,888],{},[767,874,875],{},"?v="," on ",[767,878,879],{},"\u002F_locales"," requests used to default to ",[767,882,883],{},"Date.now()",", while responses are served ",[767,886,887],{},"immutable"," for a year. Every rebuild therefore invalidated every client's dictionary, even when no translation had changed.",[753,890,891,892,894,895,863],{},"The default is now a SHA-256 fingerprint of the translation sources, in layer order. Rebuilds with untouched translations keep the same URL. Setting ",[767,893,869],{}," explicitly still wins. See ",[849,896,898,899],{"href":897},"\u002Fapi\u002Fmodule-options#datebuild","Module options — ",[767,900,869],{},[791,902,904,906,907,909],{"id":903},"httpcacheduration-for-_locales-payloads",[767,905,784],{}," for ",[767,908,879],{}," payloads",[753,911,912,913,916,917,920],{},"The built-in ",[767,914,915],{},"\u002F{apiBaseUrl}\u002F:page\u002F:locale\u002Fdata.json"," route now sends HTTP ",[767,918,919],{},"Cache-Control"," for browsers and CDN:",[807,922,923,933,939],{},[810,924,925,926,928,929,932],{},"Option: ",[767,927,784],{}," (seconds, default ",[767,930,931],{},"31536000"," \u002F 1 year)",[810,934,935,936],{},"Header: ",[767,937,938],{},"Cache-Control: public, max-age=…, immutable",[810,940,941,942,944,945,948,949,952],{},"Safe with existing ",[767,943,869],{}," cache-busting (",[767,946,947],{},"?v=...","); ",[767,950,951],{},"0"," disables the header; not applied in development",[753,954,955,956,959,960,963],{},"Analog of ",[767,957,958],{},"@nuxtjs\u002Fi18n"," v10.2.0 ",[767,961,962],{},"experimental.httpCacheDuration",", as an explicit response header.",[791,965,967],{"id":966},"compressed-public-payloads","Compressed public payloads",[753,969,970,973,974,977,978,981,982,863],{},[767,971,972],{},"nitro.compressPublicAssets"," now reaches the translation payloads copied into the public directory (",[767,975,976],{},".gz"," + ",[767,979,980],{},".br","). Nitro compresses public assets before the copy happens, so previously the payloads were the one uncompressed part of a static build — 6.65 MB raw versus 1.01 MB gzip on the playground index. The module still never enables compression on its own. See ",[849,983,479],{"href":984},"\u002Fguide\u002Fperformance#payload-size",[791,986,988,859,991],{"id":987},"resolvetranslations-and-settranslationkey-value",[767,989,990],{},"resolveTranslations()",[767,992,993],{},"setTranslation(key, value)",[753,995,996],{},"Runtime helpers to read and replace the active translation dictionary in memory:",[807,998,999,1014,1029,1041],{},[810,1000,1001,1005,1006,1009,1010,1013],{},[756,1002,1003],{},[767,1004,990],{}," returns the full tree that ",[767,1007,1008],{},"$t()"," reads from for the active locale and route — useful for DevTools, tests, and runtime editors. When a second layer is live (fallback locale or Nuxt page-transition hot-reload), the dump keeps nested shape via ",[767,1011,1012],{},"mergeTranslationLayers"," and only uses flat dotted keys for scalar-vs-object collisions that a single tree cannot otherwise express.",[810,1015,1016,1020,1021,1024,1025,1028],{},[756,1017,1018],{},[767,1019,993],{}," replaces the value at a key (top-level, dotted path, object, string, or scalar). This is a ",[756,1022,1023],{},"replace",", not a merge; use ",[767,1026,1027],{},"$mergeTranslations"," when siblings should survive.",[810,1030,1031,1032,824,1035,1038,1039,863],{},"Available on ",[767,1033,1034],{},"useI18n()",[767,1036,1037],{},"useNuxtApp()",", and framework i18n instances inherited from ",[767,1040,633],{},[810,1042,1043,1045,1046,798,1049,1052],{},[767,1044,673],{}," adds matching ",[767,1047,1048],{},"resolveTranslations",[767,1050,1051],{},"setTranslation"," helpers for unit tests.",[791,1054,1056,1059],{"id":1055},"getalltranslations-removed-from-vue-package",[767,1057,1058],{},"getAllTranslations()"," removed from Vue package",[753,1061,1062,1063,1065,1066,1069,1070,863],{},"Use ",[767,1064,990],{}," for the active lookup tree. For a full storage dump in Vue, use ",[767,1067,1068],{},"getStorage()"," or ",[767,1071,1072],{},"getRouteCache()",[748,1074,1076],{"id":1075},"breaking-changes","Breaking Changes",[753,1078,1079],{},"Nothing in the public config surface requires app code edits for typical usage. These matter if you reached into runtime internals:",[807,1081,1082,1110,1130,1143,1152],{},[810,1083,1084,1094,1095,1098,1099,1102,1103,1106,1107,1109],{},[756,1085,1086,1087,1090,1091,863],{},"The SSR payload moved from ",[767,1088,1089],{},"useState('i18n-ssr-chunks')"," to ",[767,1092,1093],{},"nuxtApp.payload.data['i18n-ssr-chunks']"," It still carries ",[756,1096,1097],{},"full translation chunks"," for every ",[767,1100,1101],{},"(locale, route)"," loaded during SSR — the same dictionaries as before, in a slot Nuxt can externalize to ",[767,1104,1105],{},"_payload.json"," on prerender. ",[767,1108,1089],{}," now returns nothing. Reading translations that way was never supported, but it was described in the cache API docs, so it is called out here.",[810,1111,1112,1121,1122,1125,1126,1129],{},[756,1113,1114,1117,1118,863],{},[767,1115,1116],{},"NuxtTranslationLoaderOptions"," exposes ",[767,1119,1120],{},"setSsrChunk"," The loader writes each merged chunk into ",[767,1123,1124],{},"payload.data"," on the server as it loads. ",[767,1127,1128],{},"getSsrChunks"," is not used.",[810,1131,1132,1142],{},[756,1133,1134,1136,1137,798,1139,1141],{},[767,1135,972],{}," now emits ",[767,1138,976],{},[767,1140,980],{}," next to the copied payloads."," Expect more files in public output if you had it enabled. Deploy tooling that enumerates the translation directory may need to account for them.",[810,1144,1145,1148,1149,1151],{},[756,1146,1147],{},"Payload URLs change once on upgrade",", because ",[767,1150,875],{}," switches from a build timestamp to a content fingerprint. Clients re-download the dictionary on the first request after the upgrade and then keep it across subsequent deploys — which is the point.",[810,1153,1154,1161,1162,798,1164,798,1166,1168],{},[756,1155,1156,1158,1159,863],{},[767,1157,1058],{}," removed from ",[767,1160,693],{}," Use ",[767,1163,990],{},[767,1165,1068],{},[767,1167,1072],{}," instead.",[748,1170,1172],{"id":1171},"bug-fixes","Bug Fixes",[807,1174,1175,1190,1217,1223,1228],{},[810,1176,1177,1181,1182,1185,1186,1189],{},[756,1178,1179],{},[767,1180,312],{}," — omits locales with ",[767,1183,1184],{},"disabled: true"," from the dropdown. ",[767,1187,1188],{},"$getLocales()"," still returns the full list for your own code, while built-in SEO\u002Fmeta output excludes disabled locales.",[810,1191,1192,1195,1196,1199,1200,1203,1204,798,1207,1210,1211,1214,1215,863],{},[756,1193,1194],{},"Switcher styles"," — ",[767,1197,1198],{},"cursor: not-allowed"," applies to the ",[756,1201,1202],{},"current"," locale via ",[767,1205,1206],{},"activeLinkStyle",[767,1208,1209],{},"customActiveLinkStyle","; restored ",[767,1212,1213],{},"customDisabledLinkStyle"," for backward compatibility and apply it to the switcher button when the current locale is ",[767,1216,1184],{},[810,1218,1219,1222],{},[756,1220,1221],{},"Dev HMR"," — a write that leaves file content unchanged (editor save-on-blur, formatter rewrite) no longer triggers a re-merge. Root-locale changes rebuild every page for that locale, so this was expensive to spend on a no-op.",[810,1224,1225,1227],{},[756,1226,1221],{}," — pages are re-merged concurrently on a root-locale change instead of one after another.",[810,1229,1230,1233,1234,1237],{},[756,1231,1232],{},"Page transitions"," — same-locale navigation keeps the outgoing chunk as a fallthrough layer until ",[767,1235,1236],{},"page:transition:finish",", instead of an expensive deep merge on every nav.",[748,1239,1241],{"id":1240},"why-it-matters","Why It Matters",[807,1243,1244,1247,1250],{},[810,1245,1246],{},"Vue I18n-style formatting without pulling in a heavier stack.",[810,1248,1249],{},"CDN-friendly translation URLs that stay stable across rebuilds when the dictionary did not change.",[810,1251,1252],{},"A supported runtime API for inspecting and patching the live dictionary — DevTools, tests, and editors no longer need private helpers.",[753,1254,1255,1256,863],{},"Full changelog will be published with the release on ",[849,1257,1261],{"href":1258,"rel":1259},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Fblob\u002Fmain\u002FCHANGELOG.md",[1260],"nofollow","GitHub",[1263,1264],"hr",{},[748,1266,1268,1269,977,1272,1275],{"id":1267},"fix-infinite-redirect-loop-with-appbaseurl-strategy-prefix-234","Fix: infinite redirect loop with ",[767,1270,1271],{},"app.baseURL",[767,1273,1274],{},"strategy: 'prefix'"," (#234)",[753,1277,1278,1280],{},[756,1279,758],{},": 2026-07-03",[753,1282,1283,1284,1287,1288,1291,1292,1295,1296,1299,1300,1303,1304,1307,1308,1311],{},"Server-side redirect plugin (",[767,1285,1286],{},"06.redirect.ts",") now strips ",[767,1289,1290],{},"runtimeConfig.app.baseURL"," from ",[767,1293,1294],{},"getRequestURL(event).pathname"," before locale detection. Fixes ",[767,1297,1298],{},"ERR_TOO_MANY_REDIRECTS"," when the app is served under a sub-path (e.g. ",[767,1301,1302],{},"\u002Fexamples"," → ",[767,1305,1306],{},"\u002Fexamples\u002Fja"," once, not ",[767,1309,1310],{},"\u002Fexamples\u002Fja\u002Fexamples\u002Fja\u002F...",").",{"title":1313,"searchDepth":1314,"depth":1314,"links":1315},"",2,[1316,1317,1331,1332,1333,1334],{"id":750,"depth":1314,"text":751},{"id":788,"depth":1314,"text":789,"children":1318},[1319,1322,1324,1326,1327,1329],{"id":793,"depth":1320,"text":1321},3,"Named numberFormats \u002F datetimeFormats + formatter cache",{"id":866,"depth":1320,"text":1323},"dateBuild defaults to a content fingerprint",{"id":903,"depth":1320,"text":1325},"httpCacheDuration for \u002F_locales payloads",{"id":966,"depth":1320,"text":967},{"id":987,"depth":1320,"text":1328},"resolveTranslations() and setTranslation(key, value)",{"id":1055,"depth":1320,"text":1330},"getAllTranslations() removed from Vue package",{"id":1075,"depth":1314,"text":1076},{"id":1171,"depth":1314,"text":1172},{"id":1240,"depth":1314,"text":1241},{"id":1267,"depth":1314,"text":1335},"Fix: infinite redirect loop with app.baseURL + strategy: 'prefix' (#234)","Release notes: v3.22.0 — Formats, Cache & Translation Memory","md","2026-11-04T00:40:16+04:00",null,{},{"order":23},{"title":368,"description":1336},"aXhBISyshvrsDH5g2m1MRO3ak469F5GiGY2s_USjCGg",[1345,1347],{"title":364,"path":365,"description":1346},"Release notes: v3.24.0 — Node SSR from public\u002F, no Rollup raw:",{"title":372,"path":373,"description":1348},"Release notes: v3.21.0 — useI18nHead for Per-Page SEO",1794050470563]