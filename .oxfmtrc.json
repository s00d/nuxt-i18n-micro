{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 150,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.output-shared/**",
    "**/.nuxt-test/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/.cache/**",
    "**/.git/**",
    "**/.astro/**",
    "**/.fixture-builds/**",
    "**/.bench/**",
    "playground/locales/pages/huge-*/**",
    "**/__golden__/**",
    "**/_locales_hashes/**",
    "test/fixtures/**/content/**"
  ],
  "overrides": [
    {
      "files": [
        "*.json",
        "*.jsonc",
        "*.json5"
      ],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
