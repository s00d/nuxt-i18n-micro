{
  "name": "@i18n-micro/vue-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "dev:ssr": "BENCH_SSR=1 node ../../../benchmark/integrations/ssr-server.mjs",
    "build:ssr": "BENCH_SSR=1 vite build --outDir dist/client && BENCH_SSR=1 vite build --ssr src/entry-server --outDir dist/server",
    "preview:ssr": "NODE_ENV=production node ../../../benchmark/integrations/ssr-server.mjs"
  },
  "dependencies": {
    "@i18n-micro/core": "workspace:^",
    "@i18n-micro/devtools-ui": "workspace:^",
    "@i18n-micro/types": "workspace:^",
    "@i18n-micro/vue": "workspace:^",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/devtools-api": "catalog:",
    "@vue/server-renderer": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vue-tsc": "catalog:"
  }
}
