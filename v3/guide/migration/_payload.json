ove translations to the ",[772,1426,1363],{}," directory in JSON format. Here is a full project comparison:",[1429,1430,1431,1440],"code-group",{},[941,1432,1438],{"className":1433,"code":1435,"filename":1436,"language":1437,"meta":946},[1434],"language-text","└── my-app\u002F\n    ├── i18n\u002F  # langDir\n    │   └── locales\u002F\n    │       ├── en.json  (- deleted)  # all translations in one file\n    │       ├── ru.json  (- deleted)\n    │       └── de.json  (- deleted)\n    ├── pages\u002F\n    │   ├── index.vue\n    │   └── page.vue\n    ├── server\u002F\n    │   └── tsconfig.json\n    ├── nuxt.config.ts  (~ modified)  # config will change\n    └── package.json\n","Before (nuxt-i18n)","text",[772,1439,1435],{"__ignoreMap":946},[941,1441,1445],{"className":1442,"code":1443,"filename":1444,"language":1437,"meta":946},[1434],"└── my-app\u002F\n    ├── locales\u002F  (+ added)  # translationDir\n    │   ├── en.json  (+ added)  # root-level translations\n    │   ├── ru.json  (+ added)\n    │   ├── de.json  (+ added)\n    │   └── pages\u002F  (+ added)  # page-specific\n    │       ├── index\u002F  (+ added)\n    │       │   ├── en.json  (+ added)\n    │       │   ├── ru.json  (+ added)\n    │       │   └── de.json  (+ added)\n    │       └── page\u002F  (+ added)\n    │           ├── en.json  (+ added)\n    │           ├── ru.json  (+ added)\n    │           └── de.json  (+ added)\n    ├── pages\u002F\n    │   ├── index.vue  (~ modified)  # API changes\n    │   └── page.vue  (~ modified)\n    ├── server\u002F\n    │   └── tsconfig.json\n    ├── nuxt.config.ts  (~ modified)  # new config\n    └── package.json\n","After (Nuxt I18n Micro)",[772,1446,1443],{"__ignoreMap":946},[1448,1449,1450],"tip",{},[969,1451,1452,1453,1456,1457,1460],{},"Missing page-specific translation files are ",[779,1454,1455],{},"auto-generated"," in development mode — just run ",[772,1458,1459],{},"nuxt dev"," and the module will create empty JSON files for each page and locale.",[936,1462,1464],{"id":1463},"_4-update-navigation","4. Update Navigation",[941,1466,1470],{"className":1467,"code":1468,"language":1469,"meta":946,"style":946},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","- \u003Cnuxt-link :to=\"{ name: 'index' }\">Home\u003C\u002Fnuxt-link>\n+ \u003CNuxtLink :to=\"$localeRoute({ name: 'index' })\">Home\u003C\u002FNuxtLink>\n+ \u003C!-- or use the built-in component -->\n+ \u003Ci18n-link :to=\"{ name: 'index' }\">Home\u003C\u002Fi18n-link>\n","diff",[772,1471,1472,1477,1482,1487],{"__ignoreMap":946},[950,1473,1474],{"class":952,"line":353},[950,1475,1476],{},"- \u003Cnuxt-link :to=\"{ name: 'index' }\">Home\u003C\u002Fnuxt-link>\n",[950,1478,1479],{"class":952,"line":1004},[950,1480,1481],{},"+ \u003CNuxtLink :to=\"$localeRoute({ name: 'index' })\">Home\u003C\u002FNuxtLink>\n",[950,1483,1484],{"class":952,"line":1030},[950,1485,1486],{},"+ \u003C!-- or use the built-in component -->\n",[950,1488,1489],{"class":952,"line":1041},[950,1490,1491],{},"+ \u003Ci18n-link :to=\"{ name: 'index' }\">Home\u003C\u002Fi18n-link>\n",[936,1493,1495],{"id":1494},"_5-update-seo","5. Update SEO",[969,1497,1498,1499,1501,1502,1505,1506,1509],{},"Remove any manual SEO configurations from ",[772,1500,849],{},". Nuxt I18n Micro generates ",[772,1503,1504],{},"hreflang",", canonical URLs, and Open Graph tags automatically when ",[772,1507,1508],{},"meta: true"," is set.",[936,1511,1513],{"id":1512},"_6-test","6. Test",[969,1515,1516],{},"Thoroughly test translations, locale switching, redirects, and SEO meta tags.",[1518,1519],"hr",{},[744,1521,1523],{"id":1522},"️-common-issues-and-troubleshooting","🛡️ Common Issues and Troubleshooting",[936,1525,1527],{"id":1526},"translation-files-not-loading","❌ Translation Files Not Loading",[969,1529,1530,1531,1534],{},"Ensure translation files are in the correct directory and follow JSON format. Verify that ",[772,1532,1533],{},"translationDir"," matches your file location.",[936,1536,1538],{"id":1537},"️-route-not-found-errors","⚠️ Route Not Found Errors",[969,1540,1541,1542,1544],{},"Check that all locale codes in ",[772,1543,1363],{}," array are correct and that routes are properly set up.",[936,1546,1548],{"id":1547},"️-missing-seo-tags","🏷️ Missing SEO Tags",[969,1550,1551,1552,1554,1555,1558],{},"Verify that ",[772,1553,1508],{}," is set and each locale has a valid ",[772,1556,1557],{},"iso"," code.",[936,1560,1562],{"id":1561},"hydration-mismatches","🔄 Hydration Mismatches",[969,1564,1565,1566,1569,1570,1573,1574,1577,1578,1581],{},"If using ",[772,1567,1568],{},"no_prefix"," strategy, set the locale in a server plugin with ",[772,1571,1572],{},"order: -10"," using ",[772,1575,1576],{},"useI18nLocale().setLocale()"," to ensure server and client agree on the locale. See ",[793,1579,1580],{"href":456},"Custom Language Detection",".",[936,1583,1585],{"id":1584},"redirects-not-working","🍪 Redirects Not Working",[969,1587,1588,1589,1592],{},"For prefix strategies, ensure ",[772,1590,1591],{},"localeCookie: 'user-locale'"," is set. Without a cookie, the server redirect plugin has no way to remember the user's preferred locale across page reloads.",[1594,1595,1596],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-defaul