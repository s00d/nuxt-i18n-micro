\u002FuseI18nLocale","v3\u002Fcomposables\u002FuseI18nLocale",{"title":735,"path":736,"stem":737,"order":39},"Examples","\u002Fv3\u002Fexamples","v3\u002Fexamples",{"id":739,"title":41,"body":740,"description":1475,"extension":1476,"lastUpdated":1477,"links":1478,"meta":1479,"navigation":1481,"path":42,"seo":1482,"stem":43,"__hash__":1483},"docs\u002Fguide\u002Fruntime-overrides.md",{"type":741,"value":742,"toc":1466},"minimark",[743,747,760,765,815,900,911,915,1132,1142,1153,1157,1253,1256,1274,1278,1359,1366,1370,1373,1411,1420,1433,1437,1447,1451,1462],[744,745,41],"h1",{"id":746},"runtime-overrides",[748,749,750,751,755,756,759],"p",{},"Runtime overrides let one build artifact run with different locale settings per environment or tenant, without rebuilding. You can change the default locale, the fallback locale, which locales are disabled, the SEO origin (",[752,753,754],"code",{},"metaBaseUrl",") and, in a build with locale domains, each locale's ",[752,757,758],{},"baseUrl",". Routing, redirects, rendering and server helpers use the overridden values, and so does the browser on a server-rendered page.",[761,762,764],"h2",{"id":763},"set-overrides-with-environment-variables","Set overrides with environment variables",[766,767,772],"pre",{"className":768,"code":769,"language":770,"meta":771,"style":771},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","NUXT_I18N_DEFAULT_LOCALE=de \\\nNUXT_I18N_FALLBACK_LOCALE=en \\\nNUXT_I18N_DISABLED_LOCALES=fr,it \\\nnode .output\u002Fserver\u002Findex.mjs\n","bash","",[752,773,774,794,800,806],{"__ignoreMap":771},[775,776,778,782,786,790],"span",{"class":777,"line":353},"line",[775,779,781],{"class":780},"sTEyZ","NUXT_I18N_DEFAULT_LOCALE",[775,783,785],{"class":784},"sMK4o","=",[775,787,789],{"class":788},"sfazB","de",[775,791,793],{"class":792},"sBMFI"," \\\n",[775,795,797],{"class":777,"line":796},2,[775,798,799],{"class":780},"NUXT_I18N_FALLBACK_LOCALE=en \\\n",[775,801,803],{"class":777,"line":802},3,[775,804,805],{"class":780},"NUXT_I18N_DISABLED_LOCALES=fr,it \\\n",[775,807,809,812],{"class":777,"line":808},4,[775,810,811],{"class":780},"node ",[775,813,814],{"class":788},".output\u002Fserver\u002Findex.mjs\n",[816,817,818,831],"table",{},[819,820,821],"thead",{},[822,823,824,828],"tr",{},[825,826,827],"th",{},"Variable",[825,829,830],{},"Alias",[832,833,834,846,858,871,883],"tbody",{},[822,835,836,841],{},[837,838,839],"td",{},[752,840,781],{},[837,842,843],{},[752,844,845],{},"NUXT_PUBLIC_I18N_RUNTIME_DEFAULT_LOCALE",[822,847,848,853],{},[837,849,850],{},[752,851,852],{},"NUXT_I18N_FALLBACK_LOCALE",[837,854,855],{},[752,856,857],{},"NUXT_PUBLIC_I18N_RUNTIME_FALLBACK_LOCALE",[822,859,860,866],{},[837,861,862,865],{},[752,863,864],{},"NUXT_I18N_DISABLED_LOCALES"," (comma-separated)",[837,867,868],{},[752,869,870],{},"NUXT_PUBLIC_I18N_RUNTIME_DISABLED_LOCALES",[822,872,873,878],{},[837,874,875],{},[752,876,877],{},"NUXT_I18N_META_BASE_URL",[837,879,880],{},[752,881,882],{},"NUXT_PUBLIC_I18N_RUNTIME_META_BASE_URL",[822,884,885,895],{},[837,886,887,890,891,894],{},[752,888,889],{},"NUXT_I18N_LOCALE_BASE_URLS"," (",[752,892,893],{},"de=https:\u002F\u002Fde.example.com,fr=https:\u002F\u002Ffr.example.com",")",[837,896,897],{},[752,898,899],{},"NUXT_PUBLIC_I18N_RUNTIME_LOCALE_BASE_URLS",[748,901,902,903,906,907,910],{},"The server reads them once at start; restart to apply a change. On a server-rendered page the browser gets the resolved values from the server. With ",[752,904,905],{},"ssr: false"," there is no server render and the browser has no environment: only ",[752,908,909],{},"runtimeConfig.public.i18nRuntime"," applies there, and the browser logs the warnings below.",[761,912,914],{"id":913},"set-overrides-in-runtimeconfig","Set overrides in runtimeConfig",[766,916,920],{"className":917,"code":918,"language":919,"meta":771,"style":771},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight"