---
import { resolveLinkHref } from '../utils'

interface Props {
  href: string
  locale?: string
  class?: string
  [key: string]: unknown
}

const { href, locale, class: className, ...attrs } = Astro.props
---

<a href={resolveLinkHref(Astro, href, locale)} class={className} {...attrs}>
  <slot />
</a>
