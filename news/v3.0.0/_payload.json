1524],{},[752,1509,1510],{},"Internal file changes",[763,1512,1513],{},"load-from-storage.ts",[763,1515,1516],{},"translation-loader.ts"," have been removed and replaced with ",[763,1519,1520],{},"storage.ts",[763,1522,1523],{},"server-loader.ts",". If you were importing from these files directly (not recommended), update your imports.",[783,1526,1528],{"id":1527},"why-it-matters","Why It Matters",[796,1530,1531,1536,1542,1548,1554,1560],{},[799,1532,1533,1535],{},[752,1534,479],{},": Centralized singleton cache eliminates per-request object creation and reduces GC pressure.",[799,1537,1538,1541],{},[752,1539,1540],{},"Maintainability",": Route and path logic live in dedicated packages with clear boundaries and types.",[799,1543,1544,1547],{},[752,1545,1546],{},"Testing",": Strategy behavior and edge cases are tested in isolation.",[799,1549,1550,1553],{},[752,1551,1552],{},"Reliability",": Split server (Nitro) and client redirect logic avoids timing issues when cookie\u002FuseState are set by user plugins.",[799,1555,1556,1559],{},[752,1557,1558],{},"Serverless-ready",": Nitro plugin runs in the same context as Nitro handlers, compatible with Edge\u002FWorkers.",[799,1561,1562,1565,1566,1569,1570,922,1575,1579],{},[752,1563,1564],{},"Documentation",": Routing behavior is documented in the ",[1502,1567,1568],{"href":52},"Strategy guide"," and in the ",[1502,1571,230],{"href":1572,"rel":1573},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Ftree\u002Fmain\u002Fpackages\u002Fpath-strategy",[1574],"nofollow",[1502,1576,242],{"href":1577,"rel":1578},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Ftree\u002Fmain\u002Fpackages\u002Froute-strategy",[1574]," packages.",[749,1581,1582,1583,994],{},"For upgrade notes and a full list of changes, see the ",[1502,1584,1587],{"href":1585,"rel":1586},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Fblob\u002Fmain\u002FCHANGELOG.md",[1574],"changelog",[1589,1590],"hr",{},[1592,159