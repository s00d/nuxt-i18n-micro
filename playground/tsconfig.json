{
  "extends": "./.nuxt/tsconfig.json",
  "exclude": ["dist", "node_modules", "playground"],
  // Nuxt 4.5+ injects vue-router/volar/* into .nuxt/tsconfig; those exports exist
  // only on vue-router@5, and the peer range also takes 4 — clear plugins so vue-tsc
  // does not warn/fail on the missing subpath.
  "vueCompilerOptions": {
    "plugins": []
  }
}
