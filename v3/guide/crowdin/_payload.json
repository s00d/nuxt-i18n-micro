2FuseI18nLocale","v3\u002Fcomposables\u002FuseI18nLocale",{"title":735,"path":736,"stem":737,"order":39},"Examples","\u002Fv3\u002Fexamples","v3\u002Fexamples",{"id":739,"title":740,"body":741,"description":1228,"extension":1229,"lastUpdated":1230,"links":1230,"meta":1231,"navigation":1232,"path":529,"seo":1233,"stem":530,"__hash__":1234},"v3\u002Fv3\u002Fguide\u002Fcrowdin.md","Crowdin Integration Guide",{"type":742,"value":743,"toc":1208},"minimark",[744,749,753,757,760,765,768,796,800,803,816,819,823,831,837,1050,1054,1101,1105,1111,1129,1133,1136,1151,1154,1158,1161,1173,1176,1180,1184,1187,1191,1194,1198,1201,1204],[745,746,748],"h2",{"id":747},"introduction","📖 Introduction",[750,751,752],"p",{},"Integrating Crowdin into your project streamlines the localization and translation process, making it easier to manage translations across multiple languages and platforms. This guide provides a step-by-step walkthrough on setting up Crowdin with your project, including configuration, uploading sources, and downloading translations.",[745,754,756],{"id":755},"installation-and-setup","🔧 Installation and Setup",[750,758,759],{},"To get started with Crowdin, you'll need to install the Crowdin CLI globally on your machine and initialize it within your project directory.",[761,762,764],"h3",{"id":763},"installing-crowdin-cli","📦 Installing Crowdin CLI",[750,766,767],{},"First, install the Crowdin CLI globally using npm:",[769,770,775],"pre",{"className":771,"code":772,"language":773,"meta":774,"style":774},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install -g @crowdin\u002Fcli\n","bash","",[776,777,778],"code",{"__ignoreMap":774},[779,780,782,786,790,793],"span",{"class":781,"line":353},"line",[779,783,785],{"class":784},"sBMFI","npm",[779,787,789],{"class":788},"sfazB"," install",[779,791,792],{"class":788}," -g",[779,794,795],{"class":788}," @crowdin\u002Fcli\n",[761,797,799],{"id":798},"initializing-crowdin-in-your-project","🛠 Initializing Crowdin in Your Project",[750,801,802],{},"Initialize Crowdin in your project by running:",[769,804,806],{"className":771,"code":805,"language":773,"meta":774,"style":774},"crowdin init\n",[776,807,808],{"__ignoreMap":774},[779,809,810,813],{"class":781,"line":353},[779,811,812],{"class":784},"crowdin",[779,814,815],{"class":788}," init\n",[750,817,818],{},"This command will guide you through the setup process, including setting your project ID, API token, and other configuration details.",[745,820,822],{"id":821},"️-configuration-guide","🗂️ Configuration Guide",[761,824,826,827,830],{"id":825},"crowdin-configuration-file-crowdinyml","📄 Crowdin Configuration File (",[776,828,829],{},"crowdin.yml",")",[750,832,833,834,836],{},"The Crowdin configuration file (",[776,835,829],{},") defines how your source files are mapped and where translations should be placed. Below is an example configuration:",[769,838,842],{"className":839,"code":840,"language":841,"meta":774,"style":774},"language-yml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","'project_id': 'YOUR_PROJECT_ID'\n'api_token': 'YOUR_API_TOKEN'\n'base_path': '.\u002Flocales'\n'base_url': 'https:\u002F\u002Fapi.crowdin.com'\n'preserve_hierarchy': true\n\nfiles:\n  [\n    { 'source': '\u002Fen.json', 'translation': '\u002F%two_letters_code%.json' },\n    { 'source': '\u002Fpages\u002F**\u002Fen.json', 'translation': '\u002Fpages\u002F**\u002F%two_letters_code%.json' },\n  ]\n","yml",[776,843,844,867,886,905,924,940,947,957,963,1006,1044],{"__ignoreMap":774},[779,845,846,850,853,855,858,861,864],{"class":781,"line":353},[779,847,849],{"class":848},"sMK4o","'",[779,851,852],{"class":788},"project_id",[779,854,849],{"class":848},[779,856,857],{"class":848},":",[779,859,860],{"class":848}," '",[779,862,863],{"class":788},"YOUR_PROJECT_ID",[779,865,866],{"class":848},"'\n",[779,868,870,872,875,877,879,881,884],{"class":781,"line":869},2,[779,871,849],{"class":848},[779,873,874],{"class":788},"api_token",[779,876,849],{"class":848},[779,878,857],{"class":848},[779,880,860],{"class":848},[779,882,883],{"class":788},"YOUR_API_TOKEN",[779,885,866],{"class":848},[779,887,889,891,894,896,898,900,903],{"class":781,"line":888},3,[779,890,849],{"class":848},[779,892,893],{"class":788},"base_path",[779,895,849],{"class":848},[779,897,857],{"class":848},[779,899,860],{"class":848},[779,901,902],{"class":788},".\u002Flocales",[779,904,866],{"class":848},[779,906,908,910,913,915,917,919,922],{"class":781,"line":907},4,[779,909,849],{"class":848},[779,911,912],{"class":788},"base_url",[779,914,849],{"class":848},[779,916,857],{"class":848},[779,918,860],{"class":848},[779,920,921],{"class":788},"https:\u002F\u002Fapi.crowdin.com",[779,923,866],{"class":848},[779,925,927,929,932,934,936],{"class":781,"line":926},5,[779,928,849],{"class":848},[779,930,931],{"class":788},"preserve_hierarchy",[779,933,849],{"class":848},[779,935,857],{"class":848},[779,937,939],{"class":938},"sfNiH"," true\n",[779,941,943],{"class":781,"line":942},6,[779,944,946],{"emptyLinePlaceholder":945},true,"\n",[779,948,950,954],{"class":781,"line":949},7,[779,951,953],{"class":952},"swJcz","files",[779,955,956],{"class":848},":\n",[779,958,960],{"class":781,"line":959},8,[779,961,962],{"class":848},"  [\n",[779,964,965,968,970,973,975,977,979,982,984,987,989,992,994,996,998,1001,1003],{"class":781,"line":358},[779,966,967],{"class":848},"    {",[779,969,860],{"class":848},[779,971,972],{"class":788},"source",[779,974,849],{"class":848},[779,976,857],{"class":848},[779,978,860],{"class":848},[779,980,981],{"class":788},"\u002Fen.json",[779,983,849],{"class":848},[779,985,986],{"class":848},",",[779,988,860],{"class":848},[779,990,991],{"class":788},"translation",[779,993,849],{"class":848},[779,995,857],{"class":848},[779,997,860],{"class":848},[779,999,1000],{"class":788},"\u002F%two_letters_code%.json",[779,1002,849],{"class":848},[779,1004,1005],{"class":848}," },\n",[779,1007,1008,1010,1012,1014,1016,1018,1020,1023,1025,1027,1029,1031,1033,1035,1037,1040,1042],{"class":781,"line":6},[779,1009,967],{"class":848},[779,1011,860],{"class":848},[779,1013,972],{"class":788},[779,1015,849],{"class":848},[779,1017,857],{"class":848},[779,1019,860],{"class":848},[779,1021,1022],{"class":788},"\u002Fpages\u002F**\u002Fen.json",[779,1024,849],{"class":848},[779,1026,986],{"class":848},[779,1028,860],{"class":848},[779,1030,991],{"class":788},[779,1032,849],{"class":848},[779,1034,857],{"class":848},[779,1036,860],{"class":848},[779,1038,1039],{"class":788},"\u002Fpages\u002F**\u002F%two_letters_code%.json",[779,1041,849],{"class":848},[779,1043,1005],{"class":848},[779,1045,1047],{"class":781,"line":1046},11,[779,1048,1049],{"class":848},"  ]\n",[761,1051,1053],{"id":1052},"key-configuration-parameters","📂 Key Configuration Parameters",[1055,1056,1057,1066,1073,1083,1090],"ul",{},[1058,1059,1060,1065],"li",{},[1061,1062,1063],"strong",{},[776,1064,852],{},": Your Crowdin project ID. This identifies the project within Crowdin where translations are managed.",[1058,1067,1068,1072],{},[1061,1069,1070],{},[776,1071,874],{},": The API token used for authentication. Ensure this token has the correct permissions to upload and download translations.",[1058,1074,1075,1079,1080,1082],{},[1061,1076,1077],{},[776,1078,893],{},": Specifies the base directory for source files. In this example, translations are stored in the ",[776,1081,902],{}," directory.",[1058,1084,1085,1089],{},[1061,1086,1087],{},[776,1088,912],{},": The base URL for the Crowdin API.",[1058,1091,1092,1096,1097,1100],{},[1061,1093,1094],{},[776,1095,931],{},": When set to ",[776,1098,1099],{},"true",", Crowdin will maintain the folder structure of your source files in the project.",[761,1102,1104],{"id":1103},"files-configuration","📂 Files Configuration",[750,1106,1107,1108,1110],{},"The ",[776,1109,953],{}," section maps your source files to the paths where translations will be stored. For example:",[1055,1112,1113,1119],{},[1058,1114,1115,1118],{},[1061,1116,1117],{},"Source Path",": Defines the location of the original translation files.",[1058,1120,1121,1124,1125,1128],{},[1061,1122,1123],{},"Translation Path",": Specifies where the translated files will be stored in Crowdin. Placeholders like ",[776,1126,1127],{},"%two_letters_code%"," are used to dynamically set the language code in the file paths.",[745,1130,1132],{"id":1131},"️-uploading-source-files-to-crowdin","⬆️ Uploading Source Files to Crowdin",[750,1134,1135],{},"Once your Crowdin configuration is set up, you can upload your source files using the following command:",[769,1137,1139],{"className":771,"code":1138,"language":773,"meta":774,"style":774},"crowdin upload sources\n",[776,1140,1141],{"__ignoreMap":774},[779,1142,1143,1145,1148],{"class":781,"line":353},[779,1144,812],{"class":784},[779,1146,1147],{"class":788}," upload",[779,1149,1150],{"class":788}," sources\n",[750,1152,1153],{},"This command uploads all specified source files in your configuration to Crowdin, making them available for translation.",[745,1155,1157],{"id":1156},"️-downloading-translations-from-crowdin","⬇️ Downloading Translations from Crowdin",[750,1159,1160],{},"After translations are completed or updated in Crowdin, you can download them to your project using:",[769,1162,1164],{"className":771,"code":1163,"language":773,"meta":774,"style":774},"crowdin download\n",[776,1165,1166],{"__ignoreMap":774},[779,1167,1168,1170],{"class":781,"line":353},[779,1169,812],{"class":784},[779,1171,1172],{"class":788}," download\n",[750,1174,1175],{},"This command fetches the latest translations from Crowdin and saves them according to the paths specified in your configuration file.",[745,1177,1179],{"id":1178},"️-best-practices","⚙️ Best Practices",[761,1181,1183],{"id":1182},"consistent-key-naming","🔑 Consistent Key Naming",[750,1185,1186],{},"Ensure translation keys are consistent across all files to avoid confusion and duplication.",[761,1188,1190],{"id":1189},"regular-maintenance","🧹 Regular Maintenance",[750,1192,1193],{},"Periodically review and clean up unused translation keys to keep your files organized and manageable.",[761,1195,1197],{"id":1196},"automate-uploads-and-downloads","🛠 Automate Uploads and Downloads",[750,1199,1200],{},"Integrate the Crowdin CLI commands into your CI\u002FCD pipeline to automate the upload of source files and download of translations, ensuring your translations are always up to date.",[750,1202,1203],{},"By following this guide, you’ll be able to seamlessly integrate Crowdin into your project, ensuring an efficient and organized approach to managing your internationalization efforts.",[1205,1206,1207],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-st