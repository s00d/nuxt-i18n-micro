[752,832,833],{},[763,834,835],{},"createNuxtI18nPluginApi"," — thin plugin surface (",[763,838,839],{},"$switchLocale",[763,841,842],{},"$localeRoute",", etc.)",[749,845,846,847,852,853,855],{},"See updated ",[848,849,851],"a",{"href":850},"\u002Fapi\u002Fi18n-cache-api","Cache & Storage Architecture"," and ",[848,854,479],{"href":95},".",[791,857,859,860],{"id":858},"ssr-payload-via-usestatei18n-ssr-chunks","SSR Payload via ",[763,861,862],{},"useState('i18n-ssr-chunks')",[749,864,865,866,869,870,873],{},"SSR translations are serialized through ",[752,867,868],{},"Nuxt state",", not a ",[763,871,872],{},"window.__I18N__"," script tag:",[875,876,877,882,888],"ol",{},[807,878,879,880],{},"Server loads chunks → ",[763,881,862],{},[807,883,884,885],{},"Client hydrates → ",[763,886,887],{},"translationStorage.seedFromSsrChunks()",[807,889,890],{},"Zero extra fetches on first paint",[749,892,893,894,896,897,855],{},"The legacy ",[763,895,872],{}," read path is ",[752,898,899],{},"removed",[791,901,903],{"id":902},"redirect-architecture-split","Redirect Architecture Split",[749,905,906],{},"Redirects are now environment-specific for clearer behavior and fewer client jank:",[908,909,910,926],"table",{},[911,912,913],"thead",{},[914,915,916,920,923],"tr",{},[917,918,919],"th",{},"Environment",[917,921,922],{},"Component",[917,924,925],{},"Role",[927,928,929,946],"tbody",{},[914,930,931,937,943],{},[932,933,934],"td",{},[752,935,936],{},"Server SSR",[932,938,939,942],{},[763,940,941],{},"06.redirect.ts"," (server-only)",[932,944,945],{},"302 before render, 404 checks, cookie sync",[914,947,948,953,958],{},[932,949,950],{},[752,951,952],{},"Client SPA",[932,954,955],{},[763,956,957],{},"i18n-redirect.global.ts",[932,959,960],{},"Global route middleware on navigation",[749,962,963,964,967,968,971,972,975,976,855],{},"Client redirects derive locale from the ",[752,965,966],{},"target route",", preserve ",[752,969,970],{},"query string and hash",", and respect ",[763,973,974],{},"redirects: false"," (middleware not registered). See ",[848,977,979],{"href":978},"\u002Fguide\u002Flocale-detection#redirects-per-strategy","Locale detection — redirects per strategy",[791,981,983,986],{"id":982},"i18nregister-hook-timing",[763,984,985],{},"i18n:register"," Hook Timing",[749,988,989,990,995,996,999,1000,1002,1003,1006,1007,855],{},"The ",[752,991,992],{},[763,993,994],{},"05.hooks"," plugin (",[763,997,998],{},"dependsOn: i18n-plugin-loader",") fires ",[763,1001,985],{}," after the loader is ready — on startup and on navigation — so user plugins reliably receive the event. Disable with ",[763,1004,1005],{},"hooks: false",". See ",[848,1008,613],{"href":202},[791,1010,1012,1013,1016],{"id":1011},"build-time-definei18nroute-extraction","Build-Time ",[763,1014,1015],{},"defineI18nRoute"," Extraction",[749,1018,1019,1020,1023,1024,1026,1027,1030,1031,1034,1035,855],{},"A Vite unplugin scans page ",[763,1021,1022],{},".vue"," files at build time and writes route meta for ",[763,1025,661],{},". Runtime ",[763,1028,1029],{},"$defineI18nRoute"," in ",[763,1032,1033],{},"script setup"," remains for dev and inline config. See ",[848,1036,1037],{"href":37},"Per-Component Translations",[786,1039,1041],{"id":1040},"bug-fixes","Bug Fixes",[804,1043,1044,1058,1064,1070,1085],{},[807,1045,1046,1049,1050,1053,1054,1057],{},[752,1047,1048],{},"SSR hydration"," — clone reactive SSR chunks before ",[763,1051,1052],{},"Object.freeze"," (fixes client ",[763,1055,1056],{},"#locale"," \u002F 404 crashes)",[807,1059,1060,1063],{},[752,1061,1062],{},"Locale switch"," — replace view layer on locale change (no stale keys from previous locale)",[807,1065,1066,1069],{},[752,1067,1068],{},"Client redirect"," — locale from target route; query\u002Fhash preserved on redirect",[807,1071,1072,1077,1078,1081,1082],{},[752,1073,1074],{},[763,1075,1076],{},"has()"," — checks active locale only; fallback applies in ",[763,1079,1080],{},"$t()",", not in ",[763,1083,1084],{},"$has()",[807,1086,1087,1092,1093,1096,1097,1100,1101,1104],{},[752,1088,1089,1091],{},[763,1090,1015],{}," meta"," — per-plugin-instance cache; longest ",[763,1094,1095],{},"rootDir"," match; correct ",[763,1098,1099],{},"pages\u002Findex"," vs ",[763,1102,1103],{},"pages\u002Findex\u002Findex"," paths",[786,1106,1108],{"id":1107},"documentation","Documentation",[749,1110,1111],{},"Guides and API reference updated for the new architecture:",[804,1113,1114,1126,1132],{},[807,1115,1116,817,1119,817,1123],{},[848,1117,1118],{"href":52},"Strategy",[848,1120,1122],{"href":1121},"\u002Fguide\u002Fv3-upgrade","v3 Upgrade",[848,1124,1125],{"href":68},"Custom Language Detection",[807,1127,1128],{},[848,1129,1131],{"href":1130},"\u002Fguide\u002Ffaq#can-i-switch-locale-without-changing-the-url","FAQ — switch locale without changing the URL",[807,1133,1134,1137,1138,852,1141,1144],{},[848,1135,430],{"href":1136},"\u002Fguide\u002Fconfiguration"," — ",[763,1139,1140],{},"redirects",[763,1142,1143],{},"hooks"," behavior",[786,1146,1148],{"id":1147},"breaking-changes","Breaking Changes",[749,1150,1151,1152,1154,1155,1157],{},"None for standard ",[763,1153,783],{}," + composables usage. Internal paths and SSR injection mechanism changed; apps that relied on manual ",[763,1156,872],{}," injection must use Nuxt payload \u002F module APIs instead.",[786,1159,1161],{"id":1160},"why-it-matters","Why It Matters",[804,1163,1164,1170,1176],{},[807,1165,1166,1169],{},[752,1167,1168],{},"More reliable SSR → client handoff"," — Nuxt-native state instead of ad-hoc globals",[807,1171,1172,1175],{},[752,1173,1174],{},"Clearer redirect model"," — server 302 before paint; client middleware only where needed",[807,1177,1178,1181],{},[752,1179,1180],{},"Easier to maintain"," — runtime split into testable units with focused regression tests",[749,1183,1184,1185,855],{},"Full changelog will be published with the release on ",[848,1186,1190],{"href":1187,"rel":1188},"https:\u002F\u002Fgithub.com\u002Fs00d\u002