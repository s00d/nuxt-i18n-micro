---
import { resolveI18nT, type I18nTProps } from '../utils'

interface Props extends Omit<I18nTProps, 'customPluralRule'> {
  tag?: string
  [key: string]: unknown
}

const { keypath, plural, params, defaultValue, tag: Tag = 'span', html = false, hideIfEmpty, number, date, relativeDate, ...attrs } = Astro.props
const text = resolveI18nT(Astro, { keypath, plural, params, defaultValue, html, hideIfEmpty, number, date, relativeDate })
---

{text !== null && (html ? <Tag {...attrs} set:html={text} /> : <Tag {...attrs}>{text}</Tag>)}
