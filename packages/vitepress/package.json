{
  "name": "@i18n-micro/vitepress",
  "version": "1.1.0",
  "description": "VitePress bindings for i18n-micro — runtime dictionaries, MD components, and locale switcher.",
  "keywords": [
    "documentation",
    "i18n",
    "internationalization",
    "translations",
    "vitepress",
    "vue"
  ],
  "homepage": "https://github.com/s00d/nuxt-i18n-micro/tree/main/packages/vitepress#readme",
  "bugs": {
    "url": "https://github.com/s00d/nuxt-i18n-micro/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/nuxt-i18n-micro.git",
    "directory": "packages/vitepress"
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      },
      "default": "./dist/config.mjs"
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.mjs"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      },
      "default": "./dist/theme.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      },
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "check:package": "publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground:dev": "vitepress dev playground",
    "playground:build": "vitepress build playground",
    "prepublishOnly": "pnpm run build && pnpm run check:package"
  },
  "dependencies": {
    "@i18n-micro/core": "workspace:^",
    "@i18n-micro/node": "workspace:^",
    "@i18n-micro/types": "workspace:^",
    "@i18n-micro/utils": "workspace:^",
    "@i18n-micro/vue": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vitepress": ">=1.0.0 || >=2.0.0-alpha.0",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
