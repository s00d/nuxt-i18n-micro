{
  "name": "nuxt-i18n-micro",
  "version": "3.30.3",
  "description": "Fast, lightweight i18n for Nuxt with strategy-based routing and minimal overhead.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "multi-language",
    "nuxt",
    "nuxt-module",
    "nuxt3",
    "performance",
    "seo",
    "translation"
  ],
  "homepage": "https://s00d.github.io/nuxt-i18n-micro/",
  "bugs": {
    "url": "https://github.com/s00d/nuxt-i18n-micro/issues"
  },
  "license": "MIT",
  "author": {
    "name": "s00d",
    "email": "Virus191288@gmail.com",
    "url": "https://s00d.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/nuxt-i18n-micro.git"
  },
  "files": [
    "dist",
    "internals.d.mts"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "internals": [
        "./internals.d.mts"
      ],
      "#i18n-internal/plural": [
        "./internals.d.mts"
      ],
      "#i18n-internal/strategy": [
        "./internals.d.mts"
      ],
      "#i18n-internal/config": [
        "./internals.d.mts"
      ],
      "#i18n-internal/payload-source": [
        "./internals.d.mts"
      ]
    }
  },
  "imports": {
    "#i18n-internal/plural": "./internals.d.mts",
    "#i18n-internal/strategy": "./internals.d.mts",
    "#i18n-internal/config": "./internals.d.mts",
    "#i18n-internal/payload-source": "./internals.d.mts"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./internals": "./internals.d.mts"
  },
  "scripts": {
    "prepack": "pnpm run build:packages && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && pnpm run client:build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:generate": "nuxi generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "bench": "node playground/bench/matrix.mjs",
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "lint": "oxlint src packages test client playground scripts/src build.config.ts",
    "lint:fix": "oxlint src packages test client playground scripts/src build.config.ts --fix",
    "format": "oxfmt --write src packages test client playground scripts/src build.config.ts",
    "format:check": "oxfmt --check src packages test client playground scripts/src build.config.ts",
    "typecheck": "pnpm run typecheck:root && pnpm run typecheck:playground && pnpm run typecheck:scripts && pnpm run typecheck:packages && pnpm run typecheck:package-playgrounds",
    "typecheck:root": "vue-tsc --noEmit -p tsconfig.nuxt.json",
    "typecheck:playground": "vue-tsc --noEmit -p playground/tsconfig.json",
    "typecheck:scripts": "pnpm -C scripts typecheck",
    "typecheck:packages": "pnpm --filter \"./packages/**\" --filter \"!./packages/*/playground\" run typecheck",
    "typecheck:package-playgrounds": "pnpm --filter \"./packages/*/playground\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:types": "vitest run --config vitest.unit.config.ts --typecheck.only",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:strategies": "vitest run --config vitest.integration.config.ts test/strategies-",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:browsers": "rc=0; for b in chromium firefox webkit; do echo \"== $b\"; E2E_BROWSER=$b vitest run --config vitest.e2e.config.ts || rc=1; done; exit $rc",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "test:dist:packages": "pnpm --filter \"./packages/*\" run --if-present test:dist",
    "test:presets": "pnpm -C scripts cli preset-smoke --preset all",
    "test:performance": "pnpm -C scripts cli performance",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:fuzz": "pnpm -C scripts cli http-fuzz",
    "docs:dev": "pnpm --filter @i18n-micro/docs dev",
    "docs:clean-dev": "pnpm --filter @i18n-micro/docs clean-dev",
    "docs:build": "pnpm --filter @i18n-micro/docs build",
    "docs:preview": "pnpm --filter @i18n-micro/docs preview",
    "docs:generate": "pnpm -C scripts cli docs-generate",
    "docs:generate:check": "pnpm -C scripts cli docs-generate --check",
    "api:surface": "pnpm -C scripts cli api-surface",
    "api:surface:update": "pnpm -C scripts cli api-surface --update",
    "audit:deps": "pnpm -C scripts cli deps-audit",
    "audit:docs": "pnpm -C scripts cli docs-audit",
    "audit:fixtures": "pnpm -C scripts cli fixtures-audit",
    "budget:payload": "pnpm -C scripts cli payload-budget",
    "budget:payload:update": "pnpm -C scripts cli payload-budget --update",
    "clean": "find . -path ./.claude -prune -o \\( -name 'node_modules' -o -name '.nuxt' -o -name '.output' -o -name 'dist' \\) -type d -prune -exec rm -rf '{}' +",
    "clean:test": "rm -rf test/.fixture-builds test/.untestutils && find test/fixtures -type d \\( -name '.nuxt' -o -name '.output-shared' -o -name '.nuxt-test' -o -name 'test-results' \\) -prune -exec rm -rf '{}' + 2>/dev/null || true",
    "check:versions": "pnpm -C scripts cli check-versions",
    "verify:packages": "pnpm -C scripts cli verify-packages",
    "verify:packages:publint": "pnpm -C scripts cli verify-packages --publint",
    "compare:published": "pnpm -C scripts cli compare-published",
    "check:consumer": "pnpm -C scripts cli consumer-types",
    "check:oldest": "pnpm -C scripts cli oldest-versions",
    "preflight": "pnpm -C scripts cli preflight",
    "bump": "pnpm -C scripts cli bump",
    "release:check": "pnpm -C scripts cli publish --check-only",
    "release:auth": "pnpm -C scripts cli ensure-npm-auth",
    "release:source": "pnpm -C scripts cli ensure-release-source",
    "release:patch": "pnpm -C scripts cli publish --bump patch",
    "release:minor": "pnpm -C scripts cli publish --bump minor",
    "release:major": "pnpm -C scripts cli publish --bump major",
    "release:packages": "pnpm -C scripts cli publish"
  },
  "dependencies": {
    "@i18n-micro/core": "workspace:^",
    "@i18n-micro/path-strategy": "workspace:^",
    "@i18n-micro/route-strategy": "workspace:^",
    "@i18n-micro/types": "workspace:^",
    "@i18n-micro/utils": "workspace:^",
    "@nuxt/devtools-kit": "catalog:",
    "@nuxt/kit": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "chokidar": "catalog:",
    "globby": "catalog:",
    "h3": "catalog:",
    "sirv": "catalog:",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:",
    "@nuxt/devtools-ui-kit": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@untestutils/nuxt": "catalog:",
    "@untestutils/perf": "catalog:",
    "@vue/devtools-api": "catalog:",
    "changelogen": "catalog:",
    "fast-check": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "untestutils": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@vue/devtools-api": "catalog:",
    "vue-router": "catalog:"
  },
  "peerDependenciesMeta": {
    "@vue/devtools-api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "@nuxtjs/sitemap": "catalog:",
      "@nuxt/kit": "catalog:pin",
      "@nuxt/schema": "catalog:pin",
      "vite": "catalog:pin",
      "vue-router": "catalog:pin",
      "react": "catalog:pin",
      "react-dom": "catalog:pin",
      "react-router-dom": "catalog:pin",
      "preact": "catalog:pin",
      "@solidjs/router": "catalog:pin",
      "typescript": "6.0.3",
      "@unhead/vue": "catalog:",
      "unhead": "catalog:"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@nuxt/module-builder>typescript": "6"
      }
    }
  },
  "stackblitz": {
    "startCommand": "pnpm install && pnpm --filter \"./packages/*\" run build && pnpm run dev:prepare && pnpm run dev",
    "env": {
      "PORT": "3000"
    }
  }
}
