{
  "name": "@i18n-micro/preact-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:ssr": "BENCH_SSR=1 node ../../../benchmark/integrations/ssr-server.mjs",
    "build:ssr": "BENCH_SSR=1 vite build --outDir dist/client && BENCH_SSR=1 vite build --ssr src/entry-server --outDir dist/server",
    "preview:ssr": "NODE_ENV=production node ../../../benchmark/integrations/ssr-server.mjs"
  },
  "dependencies": {
    "@i18n-micro/devtools-ui": "workspace:^",
    "@i18n-micro/preact": "workspace:^",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:",
    "wouter-preact": "catalog:"
  },
  "devDependencies": {
    "@preact/preset-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
