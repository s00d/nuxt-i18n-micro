5,828,833],{},[801,826,827],{},"2",[801,829,830],{},[808,831,832],{},"?locale=de",[801,834,835,836,839],{},"pages: ",[808,837,838],{},"no_prefix"," only. Server API helpers: always, and before the URL",[783,841,842,845,851],{},[801,843,844],{},"3",[801,846,847,848,811],{},"Locale state set by the app (",[808,849,850],{},"useI18nLocale().setLocale()",[801,852,853],{},"the URL has no locale",[783,855,856,859,862],{},[801,857,858],{},"4",[801,860,861],{},"Cookie",[801,863,864,870,871,874,875,811],{},[762,865,867],{"href":866},"\u002Fapi\u002Fmodule-options#localecookie",[808,868,869],{},"localeCookie"," is set (",[808,872,873],{},"'user-locale'"," automatically under ",[808,876,838],{},[783,878,879,882,888],{},[801,880,881],{},"5",[801,883,884,887],{},[808,885,886],{},"Accept-Language"," header",[801,889,890,896,897,900],{},[762,891,893],{"href":892},"\u002Fapi\u002Fmodule-options#autodetectlanguage",[808,894,895],{},"autoDetectLanguage"," is ",[808,898,899],{},"true"," (default)",[783,902,903,906,914],{},[801,904,905],{},"6",[801,907,908],{},[762,909,911],{"href":910},"\u002Fapi\u002Fmodule-options#defaultlocale",[808,912,913],{},"defaultLocale",[801,915,916],{},"always",[748,918,919,920,923,924,927,928,930],{},"So under a prefix strategy the URL decides what a page shows; the preference sources (3–5) only decide where a visitor is ",[757,921,922],{},"redirected",", and only on the paths ",[808,925,926],{},"autoDetectPath"," allows. Under ",[808,929,838],{}," there is nothing to redirect, and the preference sources decide what the page shows.",[748,932,933],{},[934,935],"img",{"alt":936,"src":937},"Decision flow: a locale prefix in the URL renders that locale. Without one, no_prefix renders from the preference sources, prefix_and_default renders the default locale, and prefix or prefix_except_default redirect by preference when autoDetectPath allows the path","\u002Fdiagrams\u002Flocale-detection.svg",[765,939,941],{"id":940},"redirects-per-strategy","Redirects per strategy",[748,943,944,945,948,949,955],{},"Redirects are a ",[808,946,947],{},"302",", made on the server before the page renders, and by a route middleware for client navigations. Query and hash are kept. With ",[762,950,952],{"href":951},"\u002Fapi\u002Fmodule-options#redirects",[808,953,954],{},"redirects: false"," none happen; wrong prefixes are still a 404.",[748,957,958,959,962,963,966,967,970],{},"Visitor prefers ",[808,960,961],{},"de"," (cookie or header), ",[808,964,965],{},"defaultLocale: 'en'",", default ",[808,968,969],{},"autoDetectPath: '\u002F'",":",[777,972,973,997],{},[780,974,975],{},[783,976,977,980,984,989,993],{},[786,978,979],{},"Request",[786,981,982],{},[808,983,817],{},[786,985,986],{},[808,987,988],{},"prefix",[786,990,991],{},[808,992,821],{},[786,994,995],{},[808,996,838],{},[796,998,999,1030,1059,1081],{},[783,1000,1001,1006,1012,1016,1024],{},[801,1002,1003],{},[808,1004,1005],{},"\u002F",[801,1007,1008,1009],{},"→ ",[808,1010,1011],{},"\u002Fde",[801,1013,1008,1014],{},[808,1015,1011],{},[801,1017,1018,1020,1021],{},[808,1019,1005],{}," in ",[808,1022,1023],{},"en",[801,1025,1026,1020,1028],{},[808,1027,1005],{},[808,1029,961],{},[783,1031,1032,1037,1043,1047,1053],{},[801,1033,1034],{},[808,1035,1036],{},"\u002Fabout",[801,1038,1039,1020,1041],{},[808,1040,1036],{},[808,1042,1023],{},[801,1044,1008,1045],{},[808,1046,810],{},[801,1048,1049,1020,1051],{},[808,1050,1036],{},[808,1052,1023],{},[801,1054,1055,1020,1057],{},[808,1056,1036],{},[808,1058,961],{},[783,1060,1061,1066,1070,1074,1078],{},[801,1062,1063],{},[808,1064,1065],{},"\u002Ffr\u002Fabout",[801,1067,1068],{},[808,1069,1065],{},[801,1071,1072],{},[808,1073,1065],{},[801,1075,1076],{},[808,1077,1065],{},[801,1079,1080],{},"—",[783,1082,1083,1088,1091,1095,1099],{},[801,1084,1085],{},[808,1086,1087],{},"\u002Fen\u002Fabout",[801,1089,1090],{},"404",[801,1092,1093],{},[808,1094,1087],{},[801,1096,1097],{},[808,1098,1087],{},[801,1100,1080],{},[748,1102,1103,1105,1106,1108,1109,1111,1112,1114,1115,1117,1118,1121,1122,1124,1125,1128],{},[808,1104,821],{}," never redirects: an unprefixed URL belongs to the default locale, and other locales live under their prefix. A visitor who prefers ",[808,1107,1023],{}," is not redirected from ",[808,1110,1005],{}," under ",[808,1113,817],{},". Targets have no trailing slash (",[808,1116,1011],{},", not ",[808,1119,1120],{},"\u002Fde\u002F",") and follow custom paths (",[808,1123,1036],{}," → ",[808,1126,1127],{},"\u002Fde\u002Fueber-uns",").",[748,1130,1131,1132,1134,1135,1137,1138,1141],{},"Wherever the cookie or the header decides (the redirect from ",[808,1133,1005],{},", every page under ",[808,1136,838],{},"), the response carries ",[808,1139,1140],{},"Vary: Cookie, Accept-Language",", so a CDN keeps the answers apart.",[1143,1144,1146],"h3",{"id":1145},"autodetectpath",[808,1147,926],{},[748,1149,1150],{},"Where the preference sources may move a visitor:",[777,1152,1153,1163],{},[780,1154,1155],{},[783,1156,1157,1160],{},[786,1158,1159],{},"Value",[786,1161,1162],{},"Preference counts on",[796,1164,1165,1177,1191,1201],{},[783,1166,1167,1172],{},[801,1168,1169,900],{},[808,1170,1171],{},"'\u002F'",[801,1173,1174,1176],{},[808,1175,1005],{}," only. Deep links stay in the language of the URL",[783,1178,1179,1184],{},[801,1180,1181],{},[808,1182,1183],{},"'no_prefix'",[801,1185,1186,1187,1124,1189,811],{},"every path without a locale prefix (",[808,1188,1036],{},[808,1190,810],{},[783,1192,1193,1198],{},[801,1194,1195],{},[808,1196,1197],{},"'\u002Fwelcome'",[801,1199,1200],{},"that exact path (a trailing slash is ignored)",[783,1202,1203,1208],{},[801,1204,1205],{},[808,1206,1207],{},"'*'",[801,1209,1210,1211,818,1213,1124,1215,1217,1218],{},"every path, prefixed ones too: ",[808,1212,1036],{},[808,1214,1065],{},[808,1216,810],{}," when the visitor prefers ",[808,1219,961],{},[1221,1222,1223,1227,1244],"ul",{},[1224,1225,1226],"li",{},"On paths it does not allow, an unprefixed URL is treated as the default locale.",[1224,1228,1229,1231,1232,1234,1235,1237,1238,1240,1241,1243],{},[808,1230,988],{}," is the exception: it has no unprefixed pages, so ",[808,1233,1036],{}," always goes to the visitor's locale (",[808,1236,810],{}," with cookie ",[808,1239,961],{},", ",[808,1242,1087],{}," with no preference).",[1224,1245,1246,1247,1249,1250,1253],{},"With ",[808,1248,1207],{}," the server ignores the app's state, and a prefixed URL no longer records its own locale in the cookie; the cookie changes when the visitor switches with ",[808,1251,1252],{},"$switchLocale",".",[1255,1256,1257],"warning",{},[748,1258,1246,1259,1261,1262,1264,1265,1267],{},[808,1260,1207],{},", shared links open in the reader's language, which can surprise. Prefer ",[808,1263,1171],{}," or ",[808,1266,1183],{}," unless that is what you want.",[765,1269,886],{"id":1270},"accept-language",[748,1272,1273,1274,1277],{},"The header is read as RFC 9110 defines it and matched against the locale ",[757,1275,1276],{},"codes"," in your config:",[1221,1279,1280,1304,1321,1342,1363],{},[1224,1281,1282,1283,1286,1287,1124,1290,1292,1293,1296,1297,1299,1300,1303],{},"Entries are tried by ",[808,1284,1285],{},"q"," value, highest first (",[808,1288,1289],{},"fr;q=0.1, de;q=0.9",[808,1291,961],{},"). ",[808,1294,1295],{},"q=0"," means \"not this language\"; an entry with a malformed ",[808,1298,1285],{}," is ignored. ",[808,1301,1302],{},"*"," matches nothing.",[1224,1305,1306,1309,1310,1313,1314,1317,1318,1128],{},[808,1307,1308],{},"_"," is read as ",[808,1311,1312],{},"-"," (",[808,1315,1316],{},"en_US"," = ",[808,1319,1320],{},"en-US",[1224,1322,1323,1324,1124,1327,1329,1330,1124,1332,1334,1335,1338,1339,1341],{},"Per entry: the exact code, then shorter forms (",[808,1325,1326],{},"de-AT",[808,1328,961],{},"), then a regional locale of the same language (",[808,1331,1023],{},[808,1333,1320],{},"). Exact and shorter forms do not depend on the order of ",[808,1336,1337],{},"locales","; among several regional matches, the first in ",[808,1340,1337],{}," wins.",[1224,1343,1344,1345,818,1348,1351,1352,1355,1356,1358,1359,1362],{},"Scripts are never crossed: ",[808,1346,1347],{},"zh-TW",[808,1349,1350],{},"zh-HK"," imply Traditional, ",[808,1353,1354],{},"zh-CN"," Simplified, so ",[808,1357,1354],{}," never matches a ",[808,1360,1361],{},"zh-Hant"," locale.",[1224,1364,1365],{},"Disabled locales never match.",[1367,1368,1373],"pre",{"className":1369,"code":1370,"language":1371,"meta":1372,"style":1372},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u002F\u002F locales: [{ code: 'en' }, { code: 'de' }, { code: 'zh-Hant' }]\n\u002F\u002F 'de-CH,de;q=0.9,en;q=0.8'  → 'de'\n\u002F\u002F 'en-GB'                    → 'en'\n\u002F\u002F 'zh-TW'                    → 'zh-Hant'\n\u002F\u002F 'zh-CN'                    → no match, next source\n","ts","",[808,1374,1375,1383,1389,1395,1401],{"__ignoreMap":1372},[1376,1377,1379],"span",{"class":1378,"line":353},"line",[1376,1380,1382],{"class":1381},"sHwdD","\u002F\u002F locales: [{ code: 'en' }, { code: 'de' }, { code: 'zh-Hant' }]\n",[1376,1384,1386],{"class":1378,"line":1385},2,[1376,1387,1388],{"class":1381},"\u002F\u002F 'de-CH,de;q=0.9,en;q=0.8'  → 'de'\n",[1376,1390,1392],{"class":1378,"line":1391},3,[1376,1393,1394],{"class":1381},"\u002F\u002F 'en-GB'                    → 'en'\n",[1376,1396,1398],{"class":1378,"line":1397},4,[1376,1399,1400],{"class":1381},"\u002F\u002F 'zh-TW'                    → 'zh-Hant'\n",[1376,1402,1404],{"class":1378,"line":1403},5,[1376,1405,1406],{"class":1381},"\u002F\u002F 'zh-CN'                    → no match, next source\n",[748,1408,1409,1410,1413],{},"Turn header detection off with ",[808,1411,1412],{},"autoDetectLanguage: false","; the cookie and the state still count.",[765,1415,1417],{"id":1416},"the-cookie","The cookie",[1221,1419,1420,1434,1446,1473,1512],{},[1224,1421,1422,1425,1426,1429,1430,1433],{},[757,1423,1424],{},"Off by default"," for the prefix strategies (",[808,1427,1428],{},"localeCookie: null","). Redirects then work from the header alone, and the choice is not remembered across visits. Set ",[808,1431,1432],{},"localeCookie: 'user-locale'"," to remember it.",[1224,1435,1436,1437,1439,1440,1442,1443,1445],{},"Under ",[808,1438,838],{}," it is ",[808,1441,873],{}," unless you set another name. ",[808,1444,1428],{}," turns it off there too.",[1224,1447,1448,1449,1240,1451,1240,1453,1455,1456,1458,1459,1462,1463,1466,1467,1469,1470,1472],{},"It is written when the visitor switches (",[808,1450,1252],{},[808,1452,312],{},[808,1454,850],{},"), and on a server render of a page under a prefix (",[808,1457,1065],{}," stores ",[808,1460,1461],{},"fr","; not under ",[808,1464,1465],{},"autoDetectPath: '*'"," with redirects on, where the URL can still move). A client navigation to a page stores that page's locale too, also on an unprefixed page of the default locale; a first load of that URL does not. Under ",[808,1468,838],{}," and in hash mode a navigation stores only a change. A 404 stores nothing, unless ",[808,1471,1252],{}," lands on it.",[1224,1474,1475,1476,1240,1479,1482,1483,1486,1487,1490,1491,1497,1498,1501,1502,1505,1506,1509,1510,1128],{},"It lasts one year (",[808,1477,1478],{},"path=\u002F",[808,1480,1481],{},"SameSite=Lax","), with no ",[808,1484,1485],{},"Domain"," and no ",[808,1488,1489],{},"Secure",". ",[762,1492,1494],{"href":1493},"\u002Fapi\u002Fmodule-options#localecookieoptions",[808,1495,1496],{},"localeCookieOptions"," changes them, e.g. ",[808,1499,1500],{},"{ domain: '.example.com' }"," to share the choice across subdomains, or ",[808,1503,1504],{},"{ sameSite: 'none', secure: true }"," for an app in an iframe (browsers drop ",[808,1507,1508],{},"SameSite=None"," without ",[808,1511,1489],{},[1224,1513,1436,1514,1517,1518,1521,1522,1524,1525,1528,1529,1531,1532,1534,1535,1537,1538,1540,1541,1543,1544,1240,1546,1548],{},[808,1515,1516],{},"hashMode"," the preference lives in the ",[808,1519,1520],{},"hash-locale"," cookie instead; server and client read the same one. The server renders that locale and, outside ",[808,1523,988],{},", never redirects; a locale in the hash (",[808,1526,1527],{},"\u002F#\u002Fde",") wins over it and applies right after hydration. Under ",[808,1530,988],{}," there is no page on ",[808,1533,1005],{},", so ",[808,1536,1005],{}," is rendered in the browser, which goes to ",[808,1539,1527],{}," by the cookie, then the browser language (",[808,1542,895],{},"); any other document (",[808,1545,1036],{},[808,1547,1011],{},") redirects into the hash.",[748,1550,1551,1552,1556,1557,1264,1560,1563],{},"Read and set the preference with ",[762,1553,1554],{"href":288},[808,1555,287],{},", not with ",[808,1558,1559],{},"useCookie",[808,1561,1562],{},"useState"," directly.",[765,1565,1567],{"id":1566},"your-own-detection","Your own detection",[748,1569,1570,1571,1574,1575,1577],{},"To pick the locale yourself (a user setting, a subdomain), call ",[808,1572,1573],{},"useI18nLocale().setLocale(code)"," in a plugin that runs before the module's plugin. It becomes source 3, the app's state. ",[762,1576,67],{"href":68}," has the full recipe, including turning the built-in detection off.",[765,1579,1581],{"id":1580},"server-api-routes","Server API routes",[748,1583,1584,818,1589,1592],{},[762,1585,1586],{"href":47},[808,1587,1588],{},"useLocaleServerMiddleware",[808,1590,1591],{},"useTranslationServerMiddleware"," use their own order, because an API URL is rarely localized:",[1594,1595,1596,1601,1608,1614,1622],"ol",{},[1224,1597,1598],{},[808,1599,1600],{},"?locale=",[1224,1602,1603,1604,1607],{},"a ",[808,1605,1606],{},"[locale]"," route param, or a locale prefix in the path",[1224,1609,1610,1611,1613],{},"cookie (when ",[808,1612,869],{}," is set)",[1224,1615,1616,1618,1619,1621],{},[808,1617,886],{}," (when ",[808,1620,895],{}," is on)",[1224,1623,1624],{},[808,1625,913],{},[748,1627,1628,818,1630,1632],{},[808,1629,1428],{},[808,1631,1412],{}," switch sources 3 and 4 off here too.",[765,1634,41],{"id":1635},"runtime-overrides",[748,1637,1638,1640],{},[762,1639,41],{"href":42}," change the list the sources are matched against:",[1221,1642,1643,1650,1660],{},[1224,1644,1645,1646,1649],{},"Runtime ",[808,1647,1648],{},"disabledLocales"," are removed from every step: a cookie or header naming one is skipped.",[1224,1651,1652,1653,1655,1656,818,1658,1253],{},"A runtime ",[808,1654,913],{}," is step 6 under ",[808,1657,988],{},[808,1659,838],{},[1224,1661,1436,1662,818,1664,1666,1667,1669],{},[808,1663,817],{},[808,1665,821],{}," the default locale is fixed at build (its pages are the unprefixed routes). A runtime ",[808,1668,913],{},", or disabling the build default, is ignored with a warning.",[765,1671,1673],{"id":1672},"related","Related",[1675,1676,1677,1681,1683],"card-group",{},[1678,1679],"card",{"icon":1680,"title":67,"to":68},"i-lucide-book-open",[1678,1682],{"icon":1680,"title":46,"to":47},[1678,1684],{"icon":1685,"title":287,"to":288},"i-lucide-braces",[1687,1688,1689],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .sh