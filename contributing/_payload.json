002Fpackages\u002F*\u002Fplayground\" run build\npnpm run dev:prepare\npnpm --filter \".\u002Fpackages\u002F*\u002Fplayground\" run build\n","bash","",[773,807,808,840,850,859,891,901],{"__ignoreMap":805},[809,810,812,816,820,823,827,830,834,837],"span",{"class":811,"line":353},"line",[809,813,815],{"class":814},"sBMFI","git",[809,817,819],{"class":818},"sfazB"," clone",[809,821,822],{"class":818}," https:\u002F\u002Fgithub.com\u002F",[809,824,826],{"class":825},"sMK4o","\u003C",[809,828,829],{"class":818},"yo",[809,831,833],{"class":832},"sTEyZ","u",[809,835,836],{"class":825},">",[809,838,839],{"class":818},"\u002Fnuxt-i18n-micro.git\n",[809,841,843,847],{"class":811,"line":842},2,[809,844,846],{"class":845},"s2Zo4","cd",[809,848,849],{"class":818}," nuxt-i18n-micro\n",[809,851,853,856],{"class":811,"line":852},3,[809,854,855],{"class":814},"pnpm",[809,857,858],{"class":818}," install\n",[809,860,862,864,867,870,873,876,878,880,883,885,888],{"class":811,"line":861},4,[809,863,855],{"class":814},[809,865,866],{"class":818}," --filter",[809,868,869],{"class":825}," \"",[809,871,872],{"class":818},".\u002Fpackages\u002F**",[809,874,875],{"class":825},"\"",[809,877,866],{"class":818},[809,879,869],{"class":825},[809,881,882],{"class":818},"!.\u002Fpackages\u002F*\u002Fplayground",[809,884,875],{"class":825},[809,886,887],{"class":818}," run",[809,889,890],{"class":818}," build\n",[809,892,894,896,898],{"class":811,"line":893},5,[809,895,855],{"class":814},[809,897,887],{"class":818},[809,899,900],{"class":818}," dev:prepare\n",[809,902,904,906,908,910,913,915,917],{"class":811,"line":903},6,[809,905,855],{"class":814},[809,907,866],{"class":818},[809,909,869],{"class":825},[809,911,912],{"class":818},".\u002Fpackages\u002F*\u002Fplayground",[809,914,875],{"class":825},[809,916,887],{"class":818},[809,918,890],{"class":818},[756,920,921,947],{},[759,922,923,926,927,930,931,934,935,938,939,942,943,946],{},[773,924,925],{},"dev:prepare"," loads ",[773,928,929],{},"src\u002Fmodule.ts",", which imports ",[773,932,933],{},"@i18n-micro\u002F*"," from their ",[773,936,937],{},"dist\u002F",", so the packages must be built first. It also writes ",[773,940,941],{},".nuxt\u002Ftsconfig.json",", which the root ",[773,944,945],{},"tsconfig.json"," extends.",[759,948,949,950,953,954,957,958,961,962,965],{},"The package playground build generates the ",[773,951,952],{},"virtual:i18n-micro\u002Fconfig"," declaration that the Astro playground needs. Skip it and ",[773,955,956],{},"pnpm run test:unit"," \u002F ",[773,959,960],{},"pnpm run typecheck"," fail with ",[773,963,964],{},"Cannot find module 'virtual:i18n-micro\u002Fconfig'",".",[747,967,968,969,972,973,976,977,798],{},"Then start the playground at ",[773,970,971],{},"http:\u002F\u002Flocalhost:3000"," (",[773,974,975],{},"\u002F"," redirects to ",[773,978,979],{},"\u002Fen",[800,981,983],{"className":802,"code":982,"language":804,"meta":805,"style":805},"pnpm run dev\n",[773,984,985],{"__ignoreMap":805},[809,986,987,989,991],{"class":811,"line":353},[809,988,855],{"class":814},[809,990,887],{"class":818},[809,992,993],{"class":818}," dev\n",[747,995,996,997,1000],{},"Warnings about ",[773,998,999],{},"localeCookie"," and large translation payloads at startup are expected.",[751,1002,1004],{"id":1003},"where-to-change-what","Where to change what",[1006,1007,1008,1021],"table",{},[1009,1010,1011],"thead",{},[1012,1013,1014,1018],"tr",{},[1015,1016,1017],"th",{},"Goal",[1015,1019,1020],{},"Location",[1022,1023,1024,1034,1044,1054,1065,1075,1088,1111,1126],"tbody",{},[1012,1025,1026,1030],{},[1027,1028,1029],"td",{},"Module options, build hooks",[1027,1031,1032],{},[773,1033,929],{},[1012,1035,1036,1039],{},[1027,1037,1038],{},"Nuxt runtime (plugins, composables, middleware, server)",[1027,1040,1041],{},[773,1042,1043],{},"src\u002Fruntime\u002F",[1012,1045,1046,1049],{},[1027,1047,1048],{},"Shared types",[1027,1050,1051],{},[773,1052,1053],{},"packages\u002Ftypes\u002Fsrc\u002F",[1012,1055,1056,1059],{},[1027,1057,1058],{},"Framework-agnostic helpers",[1027,1060,1061,1064],{},[773,1062,1063],{},"packages\u002Futils\u002Fsrc\u002F"," (subpath exports)",[1012,1066,1067,1070],{},[1027,1068,1069],{},"Translation, plural, formatting",[1027,1071,1072],{},[773,1073,1074],{},"packages\u002Fcore\u002Fsrc\u002F",[1012,1076,1077,1080],{},[1027,1078,1079],{},"Route generation \u002F runtime paths",[1027,1081,1082,957,1085],{},[773,1083,1084],{},"packages\u002Froute-strategy\u002F",[773,1086,1087],{},"packages\u002Fpath-strategy\u002F",[1012,1089,1090,1093],{},[1027,1091,1092],{},"Framework bindings",[1027,1094,1095,1098,1099,1098,1101,1098,1103,1098,1105,1098,1107,1098,1109],{},[773,1096,1097],{},"packages\u002Fvue",", ",[773,1100,238],{},[773,1102,234],{},[773,1104,250],{},[773,1106,210],{},[773,1108,226],{},[773,1110,270],{},[1012,1112,1113,1116],{},[1027,1114,1115],{},"Docs",[1027,1117,1118,1121,1122,1125],{},[773,1119,1120],{},"docs\u002F"," — never ",[773,1123,1124],{},"docs\u002Fnews\u002F"," unless a maintainer asks",[1012,1127,1128,1131],{},[1027,1129,1130],{},"E2E tests and fixtures",[1027,1132,1133,1098,1136],{},[773,1134,1135],{},"test\u002F",[773,1137,1138],{},"test\u002Ffixtures\u002F",[747,1140,1141,1142,1144,1145,1148],{},"Work in this order: types, utils, core, then the Nuxt runtime or framework package, then docs and tests. Reuse ",[773,1143,685],{}," and core instead of copying logic into a framework package. ",[1146,1147,327],"a",{"href":328}," explains how the pieces fit.",[751,1150,1152],{"id":1151},"checks","Checks",[1006,1154,1155,1165],{},[1009,1156,1157],{},[1012,1158,1159,1162],{},[1015,1160,1161],{},"Command",[1015,1163,1164],{},"What it does",[1022,1166,1167,1180,1190,1199,1208,1218,1232,1242],{},[1012,1168,1169,1177],{},[1027,1170,1171,957,1174],{},[773,1172,1173],{},"pnpm run lint",[773,1175,1176],{},"pnpm run lint:fix",[1027,1178,1179],{},"Oxlint",[1012,1181,1182,1187],{},[1027,1183,1184],{},[773,1185,1186],{},"pnpm run format",[1027,1188,1189],{},"Oxfmt",[1012,1191,1192,1196],{},[1027,1193,1194],{},[773,1195,960],{},[1027,1197,1198],{},"Root, playground, scripts, packages, package playgrounds",[1012,1200,1201,1205],{},[1027,1202,1203],{},[773,1204,956],{},[1027,1206,1207],{},"Fast unit tests, no builds",[1012,1209,1210,1215],{},[1027,1211,1212],{},[773,1213,1214],{},"pnpm run test",[1027,1216,1217],{},"Everything: unit, integration, packages, e2e",[1012,1219,1220,1225],{},[1027,1221,1222],{},[773,1223,1224],{},"pnpm run test:e2e",[1027,1226,1227,1228,1231],{},"Browser journeys (",[773,1229,1230],{},"pnpm exec playwright install chromium"," once first)",[1012,1233,1234,1239],{},[1027,1235,1236],{},[773,1237,1238],{},"pnpm run docs:generate",[1027,1240,1241],{},"Regenerate the generated docs regions after changing JSDoc, options or exports",[1012,1243,1244,1249],{},[1027,1245,1246],{},[773,1247,1248],{},"pnpm run docs:dev",[1027,1250,1251],{},"Docs site with hot reload",[747,1253,1254,1255,1098,1258,1261,1262,1265,1266,1268,1269,1271,1272,965],{},"Run at least ",[773,1256,1257],{},"lint",[773,1259,1260],{},"typecheck"," and ",[773,1263,1264],{},"test:unit"," before you push; run the full ",[773,1267,1214],{}," when you touch runtime or routing. Test layout and how to add a test: ",[1146,1270,331],{"href":332},". Every maintenance command: ",[1146,1273,335],{"href":336},[751,1275,1277],{"id":1276},"changing-a-package","Changing a package",[747,1279,1280,1281,1284,1285,1288],{},"Packages under ",[773,1282,1283],{},"packages\u002F*"," are versioned by hand; the release scripts bump only the root. ",[773,1286,1287],{},"pnpm publish -r"," silently skips a version that is already on npm, so a missing bump leaves the package stale.",[1290,1291,1292,1299,1308],"ol",{},[759,1293,1294,1295,1298],{},"Bump every changed package once per pull request (not per commit): ",[773,1296,1297],{},"pnpm run bump --level patch --packages \u003Cnames>",". Use a patch unless a maintainer decides on minor or major.",[759,1300,1301,1302,1304,1305,965],{},"Rebuild it so ",[773,1303,937],{}," matches the source: ",[773,1306,1307],{},"pnpm --filter @i18n-micro\u002F\u003Cname> build",[759,1309,1310,1311,1313,1314,1317],{},"Commit source and version together. ",[773,1312,937],{}," is gitignored; ",[773,1315,1316],{},"prepack"," rebuilds it for a release.",[747,1319,1320,1321,1324,1325,1328,1329,1332,1333,1336,1337,1341],{},"CI runs ",[773,1322,1323],{},"pnpm run check:versions"," against the merge base; changes to tests, docs and playgrounds do not count. ",[762,1326,1327],{},"Never"," edit the root ",[773,1330,1331],{},"version"," or ",[773,1334,1335],{},"CHANGELOG.md"," by hand: only the release scripts change them. ",[1146,1338,1340],{"href":1339},"\u002Fcontributing\u002Fmaintenance-commands#publishing","Publishing"," lists the commands.",[751,1343,1345],{"id":1344},"commits-and-pull-requests","Commits and pull requests",[756,1347,1348,1363,1366,1377,1380],{},[759,1349,1350,1351,1098,1354,1098,1357,1098,1360,965],{},"Conventional Commits: ",[773,1352,1353],{},"feat(scope): …",[773,1355,1356],{},"fix(scope): …",[773,1358,1359],{},"docs(scope): …",[773,1361,1362],{},"test(scope): …",[759,1364,1365],{},"Follow-ups are new commits; do not amend or force-push a branch under review.",[759,1367,1368,1369,1372,1373,1376],{},"Target ",[773,1370,1371],{},"main"," of ",[773,1374,1375],{},"s00d\u002Fnuxt-i18n-micro",", fill in the pull request template, link the issue.",[759,1378,1379],{},"Update docs when you change a public API or an exports map; add or adjust tests next to the change.",[759,1381,1382,1383,1389],{},"Bugs and feature requests go through the ",[1146,1384,1388],{"href":1385,"rel":1386},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Fissues\u002Fnew\u002Fchoose",[1387],"nofollow","issue templates","; include a reproduction.",[751,1391,1393],{"id":1392},"related","Related",[1395,1396,1397,1401,1403,1405,1407],"card-group",{},[1398,1399],"card",{"icon":1400,"title