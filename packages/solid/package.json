{
  "name": "@i18n-micro/solid",
  "version": "1.2.19",
  "description": "SolidJS bindings for i18n-micro — primitives, context, and UI components.",
  "keywords": [
    "i18n",
    "internationalization",
    "solid",
    "solidjs",
    "translations"
  ],
  "homepage": "https://github.com/s00d/nuxt-i18n-micro/tree/main/packages/solid#readme",
  "bugs": {
    "url": "https://github.com/s00d/nuxt-i18n-micro/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/nuxt-i18n-micro.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./router": {
      "solid": "./src/router/index.ts",
      "import": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.mjs"
      },
      "require": {
        "types": "./dist/router.d.cts",
        "default": "./dist/router.cjs"
      },
      "default": "./dist/router.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "check:package": "publint",
    "dev": "cd playground && vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run check:package"
  },
  "dependencies": {
    "@i18n-micro/core": "workspace:^",
    "@i18n-micro/types": "workspace:^"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "publint": "catalog:",
    "solid-js": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/router": "catalog:",
    "solid-js": "catalog:"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    },
    "@solidjs/router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
