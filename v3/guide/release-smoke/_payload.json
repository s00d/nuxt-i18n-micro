posables\u002FuseI18nLocale","v3\u002Fcomposables\u002FuseI18nLocale",{"title":735,"path":736,"stem":737,"order":39},"Examples","\u002Fv3\u002Fexamples","v3\u002Fexamples",{"id":739,"title":501,"body":740,"description":1678,"extension":1679,"lastUpdated":1680,"links":1680,"meta":1681,"navigation":1682,"path":502,"seo":1683,"stem":503,"__hash__":1684},"v3\u002Fv3\u002Fguide\u002Frelease-smoke.md",{"type":741,"value":742,"toc":1668},"minimark",[743,751,765,770,837,840,888,892,916,922,928,1121,1132,1136,1146,1204,1214,1218,1229,1232,1237,1267,1274,1280,1288,1298,1318,1321,1390,1399,1416,1420,1429,1447,1465,1518,1548,1570,1581,1621,1633,1648,1652,1655,1664],[744,745,746,747],"p",{},"The unit, integration and e2e suites all run against the module's source. None of them\nanswer the question that actually matters after a release: ",[748,749,750],"strong",{},"does the published package\ninstall into a fresh app and work?",[744,752,753,754,764],{},"That is what this workflow does. It builds a small real Nuxt app\n(",[755,756,760],"a",{"href":757,"rel":758},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Ftree\u002Fmain\u002Ftest\u002Fdeploy-smoke",[759],"nofollow",[761,762,763],"code",{},"test\u002Fdeploy-smoke",")\nagainst the module and asserts on the running result.",[766,767,769],"h2",{"id":768},"two-sources-two-different-failures","Two sources, two different failures",[771,772,773,789],"table",{},[774,775,776],"thead",{},[777,778,779,783,786],"tr",{},[780,781,782],"th",{},"Source",[780,784,785],{},"What it installs",[780,787,788],{},"What it catches",[790,791,792,818],"tbody",{},[777,793,794,800,803],{},[795,796,797],"td",{},[761,798,799],{},"git",[795,801,802],{},"tarballs packed from the current checkout",[795,804,805,806,809,810,813,814,817],{},"packaging problems ",[748,807,808],{},"before"," you publish: missing files, unresolved ",[761,811,812],{},"workspace:","\u002F",[761,815,816],{},"catalog:"," protocols, dependencies that were used but never declared",[777,819,820,825,831],{},[795,821,822],{},[761,823,824],{},"npm",[795,826,827,830],{},[761,828,829],{},"nuxt-i18n-micro@latest"," (or a version you name)",[795,832,833,834],{},"what users actually get: a bad publish, a package that never reached the registry, a version mismatch between the module and ",[761,835,836],{},"@i18n-micro\u002F*",[744,838,839],{},"Both run by default. They fail for different reasons, so neither replaces the other.",[841,842,843,851,872],"tip",{},[744,844,845],{},[748,846,847,848,850],{},"Why ",[761,849,799],{}," needs more than one tarball",[744,852,853,856,857,860,861,868,869,871],{},[761,854,855],{},"pnpm pack"," rewrites ",[761,858,859],{},"workspace:*"," to the local version numbers — which are exactly the\nones not on npm yet. So ",[755,862,865],{"href":863,"rel":864},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fnuxt-i18n-micro\u002Fblob\u002Fmain\u002Fscripts\u002Fsrc\u002Fcommands\u002Fsmoke-pack.ts",[759],[761,866,867],{},"scripts\u002Fsrc\u002Fcommands\u002Fsmoke-pack.ts","\npacks every workspace package and rewrites each tarball's ",[761,870,836],{}," dependencies\nto point at its siblings. Without that the install goes to the registry for a version\nthat does not exist.",[744,873,874,875,877,878,881,882,884,885,887],{},"Use ",[761,876,855],{},", never ",[761,879,880],{},"npm pack",": only pnpm substitutes the ",[761,883,812],{}," and ",[761,886,816],{},"\nprotocols, and a tarball still containing them cannot be installed at all.",[766,889,891],{"id":890},"running-it","Running it",[744,893,894,897,898,902,903,906,907,910,911,910,913,915],{},[748,895,896],{},"From the GitHub UI",": Actions → ",[899,900,901],"em",{},"release smoke"," → ",[899,904,905],{},"Run workflow",". Choose the source\n(",[761,908,909],{},"both",", ",[761,912,799],{},[761,914,824],{},"), optionally a specific npm version, and whether to deploy.",[744,917,918,921],{},[748,919,920],{},"Automatically",": on every published release, plus once a day — npm needs a few minutes\nto serve a freshly published version, and the daily run catches a release that was not\nyet queryable when the publish job finished.",[744,923,924,927],{},[748,925,926],{},"Locally",", against the current checkout:",[929,930,935],"pre",{"className":931,"code":932,"language":933,"meta":934,"style":934},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# pack this checkout and point the app at it\npnpm run prepack\npnpm -C scripts cli smoke-pack --app test\u002Fdeploy-smoke --out \u002Ftmp\u002Ftarballs\n\ncd test\u002Fdeploy-smoke\nprintf 'packages:\\n  - .\\n' > pnpm-workspace.yaml\npnpm install --no-frozen-lockfile\npnpm exec nuxt build\nPORT=3000 node .output\u002Fserver\u002Findex.mjs &\n\n# back in the repo root\npnpm -C scripts cli smoke-verify --url http:\u002F\u002F127.0.0.1:3000\npnpm -C scripts cli smoke-browser --url http:\u002F\u002F127.0.0.1:3000\n","bash","",[761,936,937,945,959,988,995,1005,1027,1038,1052,1073,1077,1083,1103],{"__ignoreMap":934},[938,939,941],"span",{"class":940,"line":353},"line",[938,942,944],{"class":943},"sHwdD","# pack this checkout and point the app at it\n",[938,946,948,952,956],{"class":940,"line":947},2,[938,949,951],{"class":950},"sBMFI","pnpm",[938,953,955],{"class":954},"sfazB"," run",[938,957,958],{"class":954}," prepack\n",[938,960,962,964,967,970,973,976,979,982,985],{"class":940,"line":961},3,[938,963,951],{"class":950},[938,965,966],{"class":954}," -C",[938,968,969],{"class":954}," scripts",[938,971,972],{"class":954}," cli",[938,974,975],{"class":954}," smoke-pack",[938,977,978],{"class":954}," --app",[938,980,981],{"class":954}," test\u002Fdeploy-smoke",[938,983,984],{"class":954}," --out",[938,986,987],{"class":954}," \u002Ftmp\u002Ftarballs\n",[938,989,991],{"class":940,"line":990},4,[938,992,994],{"emptyLinePlaceholder":993},true,"\n",[938,996,998,1002],{"class":940,"line":997},5,[938,999,1001],{"class":1000},"s2Zo4","cd",[938,1003,1004],{"clas